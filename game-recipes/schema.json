{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Panel de Control game recipe documents",
  "$defs": {
    "metadata": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 2
        },
        "catalog_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "schema_version",
        "catalog_version"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/",
          "maxLength": 2048
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://github\\.com/",
          "maxLength": 2048
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "format": {
          "const": "zip"
        }
      },
      "required": [
        "url",
        "source_url",
        "sha256",
        "size",
        "filename",
        "format"
      ],
      "additionalProperties": false
    },
    "dependency": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "game_files"
            },
            "asset": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "files": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 2048,
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])(?!.*//)[^/](?:.*[^/])?$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])(?!.*//)[^/](?:.*[^/])?$"
              }
            },
            "requires": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
              },
              "uniqueItems": true,
              "maxItems": 128
            }
          },
          "required": [
            "kind",
            "asset",
            "files"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "proton_dependency"
            },
            "provider": {
              "const": "winetricks"
            },
            "verb": {
              "enum": [
                "vcrun2022",
                "msvcrt40"
              ]
            },
            "requires": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
              },
              "uniqueItems": true,
              "maxItems": 128
            }
          },
          "required": [
            "kind",
            "provider",
            "verb"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "windows_redist"
            },
            "provider": {
              "const": "microsoft"
            },
            "component": {
              "enum": [
                "vc14_x64"
              ]
            },
            "min_version": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+){0,3}$"
            },
            "page_url": {
              "type": "string",
              "pattern": "^https://learn\\.microsoft\\.com/",
              "maxLength": 2048
            },
            "requires": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
              },
              "uniqueItems": true,
              "maxItems": 128
            }
          },
          "required": [
            "kind",
            "provider",
            "component",
            "min_version",
            "page_url"
          ],
          "additionalProperties": false
        }
      ]
    },
    "recipe": {
      "description": "Recipe for one operating system.",
      "type": "object",
      "properties": {
        "status": {
          "description": "tested: verified on this OS; untested: written but not yet verified.",
          "enum": [
            "tested",
            "untested"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "conditions": {
          "type": "object",
          "properties": {
            "engine": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "optiscaler",
                  "dll",
                  "helixsr",
                  "proton",
                  "mako"
                ]
              }
            },
            "arch": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "x86_64",
                  "aarch64"
                ]
              }
            },
            "game_builds": {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,19}$"
              },
              "minItems": 1
            }
          },
          "required": [
            "engine",
            "arch"
          ],
          "additionalProperties": false
        },
        "exe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])(?!.*//)[^/](?:.*[^/])?$"
        },
        "args": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^--?[A-Za-z0-9][A-Za-z0-9_=.-]*$",
            "maxLength": 128
          }
        },
        "ini": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_]+\\.[A-Za-z0-9_]+$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "source_urls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://github\\.com/",
            "maxLength": 2048
          }
        },
        "tested_game_builds": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          }
        },
        "tested_at": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ReShade.ini": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "Luma.SRUserType"
              ],
              "properties": {
                "Luma.SRUserType": {
                  "const": "2"
                },
                "OVERLAY.TutorialProgress": {
                  "const": "4"
                }
              }
            }
          }
        },
        "recommended_input": {
          "type": "string",
          "enum": [
            "dlss",
            "fsr31",
            "fsr2",
            "xess"
          ]
        },
        "effective_api": {
          "enum": [
            "d3d11",
            "d3d12",
            "vulkan"
          ]
        },
        "quality_owner": {
          "enum": [
            "panel",
            "game"
          ]
        },
        "recommended_build": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,79}$"
        },
        "optiscaler_root_files": {
          "description": "Files of the selected OptiScaler build that must also sit beside the executable.",
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^/\\\\:]+\\.[dD][lL][lL]$"
          }
        },
        "reframework_upscaler": {
          "description": "REFramework's upscaler does the upscaling; the quality setting drives its render size.",
          "type": "boolean",
          "default": false
        },
        "optiscaler_fg": {
          "description": "False when OptiScaler's own frame generation breaks the game.",
          "type": "boolean",
          "default": true
        },
        "game_settings": {
          "description": "Options the user must change in the game's own menu, in the game's words.",
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "setting": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "required": [
              "setting",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "revision",
        "conditions",
        "exe",
        "args",
        "ini",
        "dependencies",
        "source_urls"
      ],
      "additionalProperties": false
    },
    "no_recipe": {
      "description": "No recipe for this operating system. unknown: not studied yet; not_applicable: the game does not need or cannot use one there.",
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "not_applicable"
          ]
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/recipe"
        },
        {
          "$ref": "#/$defs/no_recipe"
        }
      ]
    },
    "game": {
      "description": "One game. Each operating system has its own independent block; nothing is inherited between blocks.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "linux": {
          "$ref": "#/$defs/block"
        },
        "windows": {
          "$ref": "#/$defs/block"
        }
      },
      "required": [
        "name",
        "linux",
        "windows"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "maxProperties": 512,
      "additionalProperties": {
        "$ref": "#/$defs/asset"
      }
    },
    "dependencies": {
      "type": "object",
      "maxProperties": 512,
      "additionalProperties": {
        "$ref": "#/$defs/dependency"
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/metadata"
    },
    {
      "$ref": "#/$defs/game"
    },
    {
      "$ref": "#/$defs/assets"
    },
    {
      "$ref": "#/$defs/dependencies"
    }
  ]
}

+        let config = HapticsConfig {
+            enabled: false,
+            ..HapticsConfig::default()
+        };
+
+        assert_eq!(
+            build_trigger_report(config, u16::MAX, u16::MAX),
+            [0x0d, 0x03, 0, 0, 0, 0, 0xff, 0, 0xeb],
+        );
+    }
+
+    #[test]
+    fn mix_uses_the_stronger_standard_rumble_channel() {
+        let config = HapticsConfig {
+            enabled: true,
+            left_trigger_gain: 100,
+            right_trigger_gain: 100,
+            left_trigger_source: RumbleSource::Mix,
+            right_trigger_source: RumbleSource::Off,
+        };
+
+        assert_eq!(
+            build_trigger_report(config, 10_000, 40_000),
+            [0x0d, 0x03, 156, 0, 0, 0, 0xff, 0, 0xeb],

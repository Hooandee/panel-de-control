-impl SourceOutputDevice for RogAlly {}
+impl SourceOutputDevice for RogAlly {
+    fn write_event(&mut self, event: OutputEvent) -> Result<(), OutputError> {
+        if !self.driver.supports_hd_haptics() {
+            return Ok(());
+        }
+
+        let report = match event {
+            OutputEvent::SteamDeckRumble(report) => {
+                build_trigger_report_from_steam(get_config(), report)
+            }
+            OutputEvent::GenericRumble {
+                strong_magnitude,
+                weak_magnitude,
+            } => build_trigger_report(get_config(), strong_magnitude, weak_magnitude),
+            _ => return Ok(()),
+        };
+        self.driver.write_hd_haptics(&report)?;
+        Ok(())
+    }
+
+    fn get_output_capabilities(&self) -> Result<Vec<OutputCapability>, OutputError> {
+        if self.driver.supports_hd_haptics() {
+            Ok(vec![OutputCapability::ForceFeedback])
+        } else {
+            Ok(vec![])
+        }
+    }
+
+    fn stop(&mut self) -> Result<(), OutputError> {
+        if self.driver.supports_hd_haptics() {
+            self.driver
+                .write_hd_haptics(&build_trigger_report(Default::default(), 0, 0))?;
+        }
+        Ok(())
+    }
+}
diff --git a/src/drivers/rog_ally/haptics.rs b/src/drivers/rog_ally/haptics.rs
new file mode 100644
index 0000000..772dbef
--- /dev/null
+++ b/src/drivers/rog_ally/haptics.rs
@@ -0,0 +1,119 @@
+use std::sync::{OnceLock, RwLock};
+
+use packed_struct::types::SizedInteger;
+
+use crate::drivers::steam_deck::hid_report::PackedRumbleReport;
+
+pub const HD_HAPTICS_PID: u16 = 0x1b4c;
+pub const HD_HAPTICS_INTERFACE: &str = "05";
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum RumbleSource {
+    #[default]
+    Off = 0,
+    Strong = 1,
+    Weak = 2,
+    Mix = 3,
+}
+
+impl TryFrom<u8> for RumbleSource {
+    type Error = String;
+
+    fn try_from(value: u8) -> Result<Self, Self::Error> {
+        match value {
+            0 => Ok(Self::Off),
+            1 => Ok(Self::Strong),
+            2 => Ok(Self::Weak),
+            3 => Ok(Self::Mix),
+            _ => Err(format!("invalid rumble source: {value}")),
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct HapticsConfig {
+    pub enabled: bool,
+    pub left_trigger_gain: u8,
+    pub right_trigger_gain: u8,
+    pub left_trigger_source: RumbleSource,
+    pub right_trigger_source: RumbleSource,
+}
+
+impl Default for HapticsConfig {
+    fn default() -> Self {
+        Self {
+            enabled: false,
+            left_trigger_gain: 100,
+            right_trigger_gain: 100,
+            left_trigger_source: RumbleSource::Strong,
+            right_trigger_source: RumbleSource::Weak,
+        }
+    }
+}
+
+static CONFIG: OnceLock<RwLock<HapticsConfig>> = OnceLock::new();
+
+pub fn get_config() -> HapticsConfig {
+    *CONFIG
+        .get_or_init(|| RwLock::new(HapticsConfig::default()))
+        .read()
+        .unwrap_or_else(|poisoned| poisoned.into_inner())
+}
+
+pub fn set_config(config: HapticsConfig) {
+    *CONFIG
+        .get_or_init(|| RwLock::new(HapticsConfig::default()))
+        .write()
+        .unwrap_or_else(|poisoned| poisoned.into_inner()) = config;
+}
+
+pub fn machine_supported() -> bool {
+    std::fs::read_to_string("/sys/class/dmi/id/product_name")
+        .map(|name| name.trim() == "ROG Xbox Ally X RC73XA_RC73XA")
+        .unwrap_or(false)
+}
+
+pub fn build_trigger_report(
+    config: HapticsConfig,
+    strong_magnitude: u16,
+    weak_magnitude: u16,
+) -> [u8; 9] {
+    let source_value = |source: RumbleSource| match source {
+        RumbleSource::Off => 0,
+        RumbleSource::Strong => strong_magnitude,
+        RumbleSource::Weak => weak_magnitude,
+        RumbleSource::Mix => strong_magnitude.max(weak_magnitude),
+    };
+    let scale = |value: u16, gain: u8| {
+        let normalized = ((value as u32 * 255 + u16::MAX as u32 / 2) / u16::MAX as u32) as u8;
+        ((normalized as u16 * gain.min(100) as u16 + 50) / 100) as u8
+    };
+
+    let (left, right) = if config.enabled {
+        (
+            scale(
+                source_value(config.left_trigger_source),
+                config.left_trigger_gain,
+            ),
+            scale(
+                source_value(config.right_trigger_source),
+                config.right_trigger_gain,
+            ),
+        )
+    } else {
+        (0, 0)
+    };
+
+    [0x0d, 0x03, left, right, 0, 0, 0xff, 0, 0xeb]
+}
+
+pub fn build_trigger_report_from_steam(
+    config: HapticsConfig,
+    report: PackedRumbleReport,
+) -> [u8; 9] {
+    build_trigger_report(
+        config,
+        report.left_speed.to_primitive(),
+        report.right_speed.to_primitive(),
+    )
+}


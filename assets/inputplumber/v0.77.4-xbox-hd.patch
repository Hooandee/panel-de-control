+
+    /// Whether this build and machine support the experimental Xbox HD haptics extension.
+    #[zbus(property)]
+    async fn xbox_hd_haptics_supported(&self) -> bool {
+        machine_supported()
+    }
+
+    /// Return enabled, left/right trigger gains and left/right rumble sources.
+    async fn get_xbox_hd_haptics(&self) -> (bool, u8, u8, u8, u8) {
+        let config = get_config();
+        (
+            config.enabled,
+            config.left_trigger_gain,
+            config.right_trigger_gain,
+            config.left_trigger_source as u8,
+            config.right_trigger_source as u8,
+        )
+    }
+
+    /// Configure the experimental trigger-motor enhancement for standard game rumble.
+    async fn set_xbox_hd_haptics(
+        &mut self,
+        enabled: bool,
+        left_trigger_gain: u8,
+        right_trigger_gain: u8,
+        left_trigger_source: u8,
+        right_trigger_source: u8,
+        #[zbus(connection)] conn: &Connection,
+        #[zbus(header)] hdr: Header<'_>,
+    ) -> fdo::Result<()> {
+        check_polkit(
+            conn,
+            Some(hdr),
+            "org.shadowblip.Output.ForceFeedback.Enable",
+        )
+        .await?;
+        if !machine_supported() {
+            return Err(fdo::Error::NotSupported(
+                "Xbox HD haptics are not supported on this machine".to_string(),
+            ));
+        }
+        if left_trigger_gain > 100 || right_trigger_gain > 100 {
+            return Err(fdo::Error::InvalidArgs(
+                "trigger gains must be between 0 and 100".to_string(),
+            ));
+        }
+        let left_trigger_source =
+            RumbleSource::try_from(left_trigger_source).map_err(fdo::Error::InvalidArgs)?;
+        let right_trigger_source =
+            RumbleSource::try_from(right_trigger_source).map_err(fdo::Error::InvalidArgs)?;
+        set_config(HapticsConfig {
+            enabled,
+            left_trigger_gain,
+            right_trigger_gain,
+            left_trigger_source,
+            right_trigger_source,
+        });
+        self.device
+            .stop()
+            .await
+            .map_err(|err| fdo::Error::Failed(err.to_string()))?;
+        Ok(())
+    }
 }
 

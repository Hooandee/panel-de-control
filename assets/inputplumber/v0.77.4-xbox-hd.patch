+    use super::haptics::{build_trigger_report, HapticsConfig, RumbleSource};
+
+    #[test]
+    fn maps_each_trigger_from_its_configured_game_rumble_source() {
+        let config = HapticsConfig {
+            enabled: true,
+            left_trigger_gain: 50,
+            right_trigger_gain: 25,
+            left_trigger_source: RumbleSource::Strong,
+            right_trigger_source: RumbleSource::Weak,
+        };

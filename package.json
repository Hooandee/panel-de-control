{
  "name": "panel-de-control",
  "version": "0.56.0",
  "description": "Panel de control definitivo para PCs portátiles: TDP, ventiladores y más.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test:fe": "vitest run",
    "test:i18n": "vitest run src/i18n/catalog.test.ts src/i18n/detect.test.ts src/glossary/data.test.ts src/updater/editorial.test.ts src/updater/releaseNotes.test.ts src/updater/italian.test.ts src/updater/german.test.ts src/updater/brazilianPortuguese.test.ts"
  },
  "author": "Hooandee",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.1",
    "@rollup/rollup-linux-x64-musl": "^4.63.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webpack": "^5.28.5",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "rollup": "^4.63.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.7.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.3",
      "esbuild": "^0.25.0"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}

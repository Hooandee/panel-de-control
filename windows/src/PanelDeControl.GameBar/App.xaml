<Application
    x:Class="PanelDeControl.GameBar.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!--
            PdcComponents merges PdcGlass, which merges the generated PdcTokens: one instance of every brush.
            The outer dictionary stays without Source because ApplyAccent writes keys into it at runtime.
        -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Theme/PdcComponents.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

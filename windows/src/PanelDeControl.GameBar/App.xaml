<Application
    x:Class="PanelDeControl.GameBar.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Theme/PdcTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="PdcIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <SolidColorBrush x:Key="PdcTrackBrush" Color="{StaticResource PdcHairlineColor}" />
            <Style x:Key="PdcCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PdcSurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PdcHairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PdcRadiusCard}" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <Style x:Key="PdcTileStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PdcSurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PdcHairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PdcRadiusTile}" />
                <Setter Property="Padding" Value="12" />
            </Style>
            <Style x:Key="PdcPillStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PdcHairlineBrush}" />
                <Setter Property="CornerRadius" Value="{StaticResource PdcRadiusPill}" />
                <Setter Property="Padding" Value="10,4" />
            </Style>
            <Style x:Key="PdcCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PdcFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource PdcFontCaption}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="Foreground" Value="{StaticResource PdcTextMutedBrush}" />
            </Style>
            <Style x:Key="PdcBodyStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PdcFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource PdcFontBody}" />
                <Setter Property="Foreground" Value="{StaticResource PdcTextPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="PdcMutedStyle" TargetType="TextBlock" BasedOn="{StaticResource PdcBodyStyle}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource PdcTextMutedBrush}" />
            </Style>
            <Style x:Key="PdcValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PdcFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource PdcFontValue}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PdcTextPrimaryBrush}" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>
            <Style x:Key="PdcInlineValueStyle" TargetType="TextBlock" BasedOn="{StaticResource PdcValueStyle}">
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style x:Key="PdcTabButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource PdcRadiusControl}" />
                <Setter Property="Foreground" Value="{StaticResource PdcTextMutedBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="4,6" />
                <Setter Property="IsTabStop" Value="True" />
            </Style>
            <Style x:Key="PdcChipButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PdcHairlineBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource PdcRadiusControl}" />
                <Setter Property="Foreground" Value="{StaticResource PdcTextPrimaryBrush}" />
                <Setter Property="FontSize" Value="{StaticResource PdcFontBody}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="4,6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<Application
    x:Class="PanelDeControl.GameBar.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!--
            Order matters: generated tokens, then the skin (Skins.cs swaps slot 1 and may override tokens), then the
            components, which read both through ThemeResource. The outer dictionary has no Source because
            ApplyAccent writes keys into it at runtime.
        -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Theme/PdcTokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Theme/Skins/PdcSkinGlass.xaml" />
                <ResourceDictionary Source="ms-appx:///Theme/PdcComponents.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows-only glass and motion tokens. Every literal colour of the widget outside PdcTokens.xaml lives here. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Theme/PdcTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Color x:Key="PdcGlassHiColor">#1CFFFFFF</Color>
    <Color x:Key="PdcGlassLoColor">#08FFFFFF</Color>
    <Color x:Key="PdcRimHiColor">#40FFFFFF</Color>
    <Color x:Key="PdcRimMidColor">#0DFFFFFF</Color>
    <Color x:Key="PdcRimLoColor">#1AFFFFFF</Color>
    <Color x:Key="PdcShellColor">#FF050509</Color>
    <Color x:Key="PdcScrimColor">#B3050509</Color>
    <Color x:Key="PdcKnobColor">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="PdcShellBrush" Color="{StaticResource PdcShellColor}" />
    <SolidColorBrush x:Key="PdcKnobBrush" Color="{StaticResource PdcKnobColor}" />
    <SolidColorBrush x:Key="PdcRimHiBrush" Color="{StaticResource PdcRimHiColor}" />
    <SolidColorBrush x:Key="PdcLayerBrush" Color="{StaticResource PdcTextPrimaryColor}" Opacity="0.045" />
    <SolidColorBrush x:Key="PdcLayerStrongBrush" Color="{StaticResource PdcTextPrimaryColor}" Opacity="0.1" />
    <SolidColorBrush x:Key="PdcTrackBrush" Color="{StaticResource PdcTextPrimaryColor}" Opacity="0.09" />
    <SolidColorBrush x:Key="PdcTransparentBrush" Color="{StaticResource PdcKnobColor}" Opacity="0" />

    <!-- Accent-derived brushes: ControlPanelWidget.ApplyAccent repaints them when the accent changes. -->
    <SolidColorBrush x:Key="PdcAccentSoftBrush" Color="{StaticResource PdcAccentColor}" Opacity="0.26" />
    <SolidColorBrush x:Key="PdcAccentRimBrush" Color="{StaticResource PdcAccentColor}" Opacity="0.7" />

    <!-- Glass: a top-lit translucent fill with a brighter rim on the lit edge. -->
    <LinearGradientBrush x:Key="PdcGlassBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource PdcGlassHiColor}" />
        <GradientStop Offset="1" Color="{StaticResource PdcGlassLoColor}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PdcGlassRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource PdcRimHiColor}" />
        <GradientStop Offset="0.45" Color="{StaticResource PdcRimMidColor}" />
        <GradientStop Offset="1" Color="{StaticResource PdcRimLoColor}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PdcShellFadeBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0" Color="{StaticResource PdcGlassLoColor}" />
        <GradientStop Offset="1" Color="{StaticResource PdcScrimColor}" />
    </LinearGradientBrush>

    <CornerRadius x:Key="PdcRadiusSurface">22</CornerRadius>
    <CornerRadius x:Key="PdcRadiusInset">14</CornerRadius>
    <CornerRadius x:Key="PdcRadiusChip">12</CornerRadius>
    <CornerRadius x:Key="PdcRadiusBar">20</CornerRadius>
    <Thickness x:Key="PdcRimThickness">1</Thickness>
    <Thickness x:Key="PdcCardPadding">18,16</Thickness>
    <Thickness x:Key="PdcFocusMargin">-3</Thickness>
    <Thickness x:Key="PdcFocusThickness">2</Thickness>

    <!-- Motion: press is quick, release springs back, state changes glide. -->
    <Duration x:Key="PdcMotionPress">0:0:0.08</Duration>
    <Duration x:Key="PdcMotionHover">0:0:0.14</Duration>
    <Duration x:Key="PdcMotionGlide">0:0:0.32</Duration>
    <x:Double x:Key="PdcPressScale">0.95</x:Double>
    <x:Double x:Key="PdcThumbPressScale">1.25</x:Double>
</ResourceDictionary>

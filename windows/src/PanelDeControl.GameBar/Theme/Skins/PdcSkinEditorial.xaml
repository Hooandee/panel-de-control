<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Skin D, "Editorial": almost no boxes, huge condensed numbers, one acid accent. Same keys as PdcSkinGlass.xaml. -->
    <Color x:Key="PdcSkinInkColor">#FFF2F2EE</Color>
    <Color x:Key="PdcSkinLimeColor">#FFD6FF3D</Color>
    <Color x:Key="PdcSkinClearColor">#00F2F2EE</Color>

    <SolidColorBrush x:Key="PdcAccentBrush" Color="{StaticResource PdcSkinLimeColor}" />
    <SolidColorBrush x:Key="PdcOnAccentBrush" Color="#FF0C0C0C" />
    <SolidColorBrush x:Key="PdcTextPrimaryBrush" Color="{StaticResource PdcSkinInkColor}" />
    <SolidColorBrush x:Key="PdcTextMutedBrush" Color="#FF8A8A85" />

    <SolidColorBrush x:Key="PdcShellBrush" Color="#FF0C0C0C" />
    <SolidColorBrush x:Key="PdcKnobBrush" Color="{StaticResource PdcSkinInkColor}" />
    <SolidColorBrush x:Key="PdcTransparentBrush" Color="{StaticResource PdcSkinClearColor}" />
    <SolidColorBrush x:Key="PdcLayerBrush" Color="{StaticResource PdcSkinClearColor}" />
    <SolidColorBrush x:Key="PdcLayerStrongBrush" Color="#FF1C1C1A" />
    <SolidColorBrush x:Key="PdcTrackBrush" Color="#FF2C2C2A" />
    <SolidColorBrush x:Key="PdcRimHiBrush" Color="{StaticResource PdcSkinLimeColor}" />
    <SolidColorBrush x:Key="PdcDangerSoftBrush" Color="#40E05A5A" />
    <SolidColorBrush x:Key="PdcWashBrush" Color="{StaticResource PdcSkinInkColor}" />
    <SolidColorBrush x:Key="PdcChoiceTextBrush" Color="#FF0C0C0C" />
    <SolidColorBrush x:Key="PdcTabSelectedTextBrush" Color="{StaticResource PdcSkinInkColor}" />
    <SolidColorBrush x:Key="PdcAccentSoftBrush" Color="{StaticResource PdcSkinInkColor}" />
    <SolidColorBrush x:Key="PdcAccentRimBrush" Color="{StaticResource PdcSkinInkColor}" />
    <SolidColorBrush x:Key="PdcIconTileBrush" Color="{StaticResource PdcSkinClearColor}" />
    <SolidColorBrush x:Key="PdcTabIndicatorBrush" Color="{StaticResource PdcSkinLimeColor}" />
    <SolidColorBrush x:Key="PdcTabIndicatorRimBrush" Color="{StaticResource PdcSkinLimeColor}" />
    <SolidColorBrush x:Key="PdcCardBrush" Color="{StaticResource PdcSkinClearColor}" />
    <SolidColorBrush x:Key="PdcCardRimBrush" Color="#FF262624" />
    <SolidColorBrush x:Key="PdcChipBrush" Color="{StaticResource PdcSkinClearColor}" />
    <SolidColorBrush x:Key="PdcShellFadeBrush" Color="{StaticResource PdcSkinClearColor}" />
    <SolidColorBrush x:Key="PdcSegmentMaskBrush" Color="{StaticResource PdcSkinClearColor}" />
    <SolidColorBrush x:Key="PdcBackdropRowsBrush" Color="{StaticResource PdcSkinClearColor}" />
    <SolidColorBrush x:Key="PdcBackdropColumnsBrush" Color="{StaticResource PdcSkinClearColor}" />

    <Thickness x:Key="PdcRimThickness">1</Thickness>
    <Thickness x:Key="PdcCardBorderThickness">0,0,0,1</Thickness>
    <Thickness x:Key="PdcCardPadding">0,18</Thickness>
    <Thickness x:Key="PdcCardMargin">0</Thickness>
    <CornerRadius x:Key="PdcRadiusSurface">0</CornerRadius>
    <CornerRadius x:Key="PdcRadiusInset">0</CornerRadius>
    <CornerRadius x:Key="PdcRadiusChip">0</CornerRadius>
    <CornerRadius x:Key="PdcRadiusBar">0</CornerRadius>
    <CornerRadius x:Key="PdcRadiusRound">0</CornerRadius>
    <CornerRadius x:Key="PdcRadiusToggle">0</CornerRadius>
    <CornerRadius x:Key="PdcRadiusKnob">0</CornerRadius>
    <CornerRadius x:Key="PdcRadiusThumb">0</CornerRadius>
    <x:Double x:Key="PdcTrackHeight">3</x:Double>
    <x:Double x:Key="PdcThumbWidth">4</x:Double>
    <x:Double x:Key="PdcThumbHeight">24</x:Double>
    <x:Double x:Key="PdcFillGlowOpacity">0</x:Double>
    <x:Double x:Key="PdcArcThickness">10</x:Double>
    <x:Double x:Key="PdcHeroValueSize">132</x:Double>
    <x:Int32 x:Key="PdcLabelSpacing">0</x:Int32>

    <FontFamily x:Key="PdcFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="PdcDisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="PdcNumberFontFamily">Bahnschrift</FontFamily>
</ResourceDictionary>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Skin A, "Cristal tallado" (default). Every other skin defines at least these keys and may also override
        generated tokens; PdcComponents reads them with ThemeResource, so a skin is only ever a set of values.
    -->
    <Color x:Key="PdcSkinTextColor">#EBFFFFFF</Color>
    <Color x:Key="PdcSkinClearColor">#00FFFFFF</Color>

    <SolidColorBrush x:Key="PdcShellBrush" Color="#FF06070A" />
    <SolidColorBrush x:Key="PdcKnobBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PdcTransparentBrush" Color="{StaticResource PdcSkinClearColor}" />
    <SolidColorBrush x:Key="PdcLayerBrush" Color="{StaticResource PdcSkinTextColor}" Opacity="0.045" />
    <SolidColorBrush x:Key="PdcLayerStrongBrush" Color="{StaticResource PdcSkinTextColor}" Opacity="0.1" />
    <SolidColorBrush x:Key="PdcTrackBrush" Color="{StaticResource PdcSkinTextColor}" Opacity="0.09" />
    <SolidColorBrush x:Key="PdcRimHiBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="PdcDangerSoftBrush" Color="#40E05A5A" />
    <SolidColorBrush x:Key="PdcWashBrush" Color="{StaticResource PdcSkinTextColor}" />
    <SolidColorBrush x:Key="PdcChoiceTextBrush" Color="{StaticResource PdcSkinTextColor}" />
    <SolidColorBrush x:Key="PdcTabSelectedTextBrush" Color="{StaticResource PdcSkinTextColor}" />
    <SolidColorBrush x:Key="PdcSegmentMaskBrush" Color="{StaticResource PdcSkinClearColor}" />
    <SolidColorBrush x:Key="PdcBackdropRowsBrush" Color="{StaticResource PdcSkinClearColor}" />
    <SolidColorBrush x:Key="PdcBackdropColumnsBrush" Color="{StaticResource PdcSkinClearColor}" />

    <!-- Accent-derived: ControlPanelWidget.ApplyAccent repaints them with the user's accent (this skin only). -->
    <SolidColorBrush x:Key="PdcAccentSoftBrush" Color="#FF4EA1FF" Opacity="0.26" />
    <SolidColorBrush x:Key="PdcAccentRimBrush" Color="#FF4EA1FF" Opacity="0.7" />
    <SolidColorBrush x:Key="PdcIconTileBrush" Color="#FF4EA1FF" Opacity="0.2" />
    <SolidColorBrush x:Key="PdcTabIndicatorBrush" Color="#FF4EA1FF" Opacity="0.26" />
    <SolidColorBrush x:Key="PdcTabIndicatorRimBrush" Color="#FF4EA1FF" Opacity="0.7" />

    <!-- The cut-glass look: a reflection band over the first pixels of every surface and a lit upper lip. -->
    <LinearGradientBrush x:Key="PdcCardBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,140">
        <GradientStop Offset="0" Color="#1EFFFFFF" />
        <GradientStop Offset="0.38" Color="#10FFFFFF" />
        <GradientStop Offset="0.39" Color="#08FFFFFF" />
        <GradientStop Offset="1" Color="#05FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PdcCardRimBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,48">
        <GradientStop Offset="0" Color="#80FFFFFF" />
        <GradientStop Offset="0.12" Color="#2AFFFFFF" />
        <GradientStop Offset="1" Color="#10FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PdcChipBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,44">
        <GradientStop Offset="0" Color="#1AFFFFFF" />
        <GradientStop Offset="0.45" Color="#0EFFFFFF" />
        <GradientStop Offset="0.46" Color="#07FFFFFF" />
        <GradientStop Offset="1" Color="#05FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PdcShellFadeBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0" Color="#08FFFFFF" />
        <GradientStop Offset="1" Color="#B306070A" />
    </LinearGradientBrush>

    <Thickness x:Key="PdcRimThickness">1</Thickness>
    <Thickness x:Key="PdcCardBorderThickness">1</Thickness>
    <Thickness x:Key="PdcCardPadding">18,16</Thickness>
    <Thickness x:Key="PdcCardMargin">0,0,0,12</Thickness>
    <CornerRadius x:Key="PdcRadiusSurface">22</CornerRadius>
    <CornerRadius x:Key="PdcRadiusInset">14</CornerRadius>
    <CornerRadius x:Key="PdcRadiusChip">12</CornerRadius>
    <CornerRadius x:Key="PdcRadiusBar">20</CornerRadius>
    <CornerRadius x:Key="PdcRadiusRound">9</CornerRadius>
    <CornerRadius x:Key="PdcRadiusToggle">15</CornerRadius>
    <CornerRadius x:Key="PdcRadiusKnob">11</CornerRadius>
    <CornerRadius x:Key="PdcRadiusThumb">13</CornerRadius>
    <x:Double x:Key="PdcTrackHeight">8</x:Double>
    <x:Double x:Key="PdcThumbWidth">26</x:Double>
    <x:Double x:Key="PdcThumbHeight">26</x:Double>
    <x:Double x:Key="PdcFillGlowOpacity">0.28</x:Double>
    <x:Double x:Key="PdcArcThickness">10</x:Double>
    <x:Double x:Key="PdcHeroValueSize">60</x:Double>
    <x:Int32 x:Key="PdcLabelSpacing">0</x:Int32>

    <FontFamily x:Key="PdcFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="PdcDisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="PdcNumberFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
</ResourceDictionary>

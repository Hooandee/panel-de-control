<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Skin B, "Instrumento": amber phosphor cockpit. Same keys as PdcSkinGlass.xaml. -->
    <Color x:Key="PdcSkinAmberColor">#FFFFB547</Color>
    <Color x:Key="PdcSkinClearColor">#00FFB547</Color>

    <!-- Overrides of generated tokens: this skin brings its own palette. -->
    <SolidColorBrush x:Key="PdcAccentBrush" Color="{StaticResource PdcSkinAmberColor}" />
    <SolidColorBrush x:Key="PdcOnAccentBrush" Color="#FF140D02" />
    <SolidColorBrush x:Key="PdcTextPrimaryBrush" Color="#FFFFE3B8" />
    <SolidColorBrush x:Key="PdcTextMutedBrush" Color="#FFB08045" />
    <SolidColorBrush x:Key="PdcBrightnessBrush" Color="#FFFFD27A" />
    <SolidColorBrush x:Key="PdcOkBrush" Color="#FF7EE08A" />

    <SolidColorBrush x:Key="PdcShellBrush" Color="#FF0B0906" />
    <SolidColorBrush x:Key="PdcKnobBrush" Color="#FFFFE3B8" />
    <SolidColorBrush x:Key="PdcTransparentBrush" Color="{StaticResource PdcSkinClearColor}" />
    <SolidColorBrush x:Key="PdcLayerBrush" Color="{StaticResource PdcSkinAmberColor}" Opacity="0.05" />
    <SolidColorBrush x:Key="PdcLayerStrongBrush" Color="{StaticResource PdcSkinAmberColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="PdcTrackBrush" Color="{StaticResource PdcSkinAmberColor}" Opacity="0.16" />
    <SolidColorBrush x:Key="PdcRimHiBrush" Color="{StaticResource PdcSkinAmberColor}" />
    <SolidColorBrush x:Key="PdcDangerSoftBrush" Color="#40E8643C" />
    <SolidColorBrush x:Key="PdcWashBrush" Color="{StaticResource PdcSkinAmberColor}" />
    <SolidColorBrush x:Key="PdcChoiceTextBrush" Color="#FFFFE3B8" />
    <SolidColorBrush x:Key="PdcTabSelectedTextBrush" Color="#FF140D02" />
    <SolidColorBrush x:Key="PdcAccentSoftBrush" Color="{StaticResource PdcSkinAmberColor}" Opacity="0.18" />
    <SolidColorBrush x:Key="PdcAccentRimBrush" Color="{StaticResource PdcSkinAmberColor}" />
    <SolidColorBrush x:Key="PdcIconTileBrush" Color="{StaticResource PdcSkinAmberColor}" Opacity="0.1" />
    <SolidColorBrush x:Key="PdcTabIndicatorBrush" Color="{StaticResource PdcSkinAmberColor}" />
    <SolidColorBrush x:Key="PdcTabIndicatorRimBrush" Color="{StaticResource PdcSkinAmberColor}" />
    <SolidColorBrush x:Key="PdcCardBrush" Color="{StaticResource PdcSkinAmberColor}" Opacity="0.035" />
    <SolidColorBrush x:Key="PdcCardRimBrush" Color="{StaticResource PdcSkinAmberColor}" Opacity="0.3" />
    <SolidColorBrush x:Key="PdcChipBrush" Color="{StaticResource PdcSkinClearColor}" />
    <SolidColorBrush x:Key="PdcShellFadeBrush" Color="{StaticResource PdcSkinClearColor}" />

    <!-- Gaps cut into filled tracks turn them into LED segments. -->
    <LinearGradientBrush x:Key="PdcSegmentMaskBrush" MappingMode="Absolute" SpreadMethod="Repeat" StartPoint="0,0" EndPoint="12,0">
        <GradientStop Offset="0" Color="{StaticResource PdcSkinClearColor}" />
        <GradientStop Offset="0.74" Color="{StaticResource PdcSkinClearColor}" />
        <GradientStop Offset="0.75" Color="#FF0B0906" />
        <GradientStop Offset="1" Color="#FF0B0906" />
    </LinearGradientBrush>
    <!-- Faint 20 px drafting grid behind everything. -->
    <LinearGradientBrush x:Key="PdcBackdropRowsBrush" MappingMode="Absolute" SpreadMethod="Repeat" StartPoint="0,0" EndPoint="0,20">
        <GradientStop Offset="0" Color="#0BFFB547" />
        <GradientStop Offset="0.05" Color="#0BFFB547" />
        <GradientStop Offset="0.06" Color="{StaticResource PdcSkinClearColor}" />
        <GradientStop Offset="1" Color="{StaticResource PdcSkinClearColor}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PdcBackdropColumnsBrush" MappingMode="Absolute" SpreadMethod="Repeat" StartPoint="0,0" EndPoint="20,0">
        <GradientStop Offset="0" Color="#0BFFB547" />
        <GradientStop Offset="0.05" Color="#0BFFB547" />
        <GradientStop Offset="0.06" Color="{StaticResource PdcSkinClearColor}" />
        <GradientStop Offset="1" Color="{StaticResource PdcSkinClearColor}" />
    </LinearGradientBrush>

    <Thickness x:Key="PdcRimThickness">1</Thickness>
    <Thickness x:Key="PdcCardBorderThickness">1</Thickness>
    <Thickness x:Key="PdcCardPadding">16,14</Thickness>
    <Thickness x:Key="PdcCardMargin">0,0,0,10</Thickness>
    <Thickness x:Key="PdcBlockFocusMargin">-2,-2,-2,8</Thickness>
    <CornerRadius x:Key="PdcRadiusSurface">2</CornerRadius>
    <CornerRadius x:Key="PdcRadiusInset">2</CornerRadius>
    <CornerRadius x:Key="PdcRadiusChip">1</CornerRadius>
    <CornerRadius x:Key="PdcRadiusBar">2</CornerRadius>
    <CornerRadius x:Key="PdcRadiusRound">2</CornerRadius>
    <CornerRadius x:Key="PdcRadiusToggle">2</CornerRadius>
    <CornerRadius x:Key="PdcRadiusKnob">1</CornerRadius>
    <CornerRadius x:Key="PdcRadiusThumb">1</CornerRadius>
    <x:Double x:Key="PdcTrackHeight">16</x:Double>
    <x:Double x:Key="PdcThumbWidth">6</x:Double>
    <x:Double x:Key="PdcThumbHeight">28</x:Double>
    <x:Double x:Key="PdcFillGlowOpacity">0</x:Double>
    <x:Double x:Key="PdcArcThickness">3</x:Double>
    <x:Double x:Key="PdcHeroValueSize">54</x:Double>
    <x:Int32 x:Key="PdcLabelSpacing">120</x:Int32>

    <FontFamily x:Key="PdcFontFamily">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="PdcDisplayFontFamily">Bahnschrift</FontFamily>
    <FontFamily x:Key="PdcNumberFontFamily">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>

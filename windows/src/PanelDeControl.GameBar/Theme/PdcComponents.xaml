<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Component catalog of the Windows widget. Every value comes from the active skin (Theme/Skins) through
        ThemeResource, so one template serves every skin. Screens assign a style from here; they never restyle a
        piece locally.
    -->
    <FontFamily x:Key="PdcIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <Duration x:Key="PdcMotionPress">0:0:0.08</Duration>
    <Duration x:Key="PdcMotionHover">0:0:0.14</Duration>
    <x:Double x:Key="PdcPressScale">0.95</x:Double>
    <x:Double x:Key="PdcThumbPressScale">1.2</x:Double>
    <Thickness x:Key="PdcFocusMargin">-3</Thickness>
    <Thickness x:Key="PdcFocusThickness">2</Thickness>

    <!-- Surfaces -->
    <Style x:Key="PdcCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PdcCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PdcCardRimBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource PdcCardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{ThemeResource PdcRadiusSurface}" />
        <Setter Property="Padding" Value="{ThemeResource PdcCardPadding}" />
        <Setter Property="Margin" Value="{ThemeResource PdcCardMargin}" />
    </Style>
    <Style x:Key="PdcTileStyle" TargetType="Border" BasedOn="{StaticResource PdcCardStyle}">
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="PdcInsetStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PdcLayerBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PdcCardRimBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource PdcRimThickness}" />
        <Setter Property="CornerRadius" Value="{ThemeResource PdcRadiusInset}" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style x:Key="PdcBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PdcCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PdcCardRimBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource PdcRimThickness}" />
        <Setter Property="CornerRadius" Value="{ThemeResource PdcRadiusBar}" />
        <Setter Property="Padding" Value="5" />
    </Style>
    <Style x:Key="PdcPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PdcLayerBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PdcCardRimBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource PdcRimThickness}" />
        <Setter Property="CornerRadius" Value="{ThemeResource PdcRadiusRound}" />
        <Setter Property="Padding" Value="10,3,10,4" />
    </Style>
    <Style x:Key="PdcIconTileStyle" TargetType="Border">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="{ThemeResource PdcRadiusChip}" />
        <Setter Property="Background" Value="{ThemeResource PdcAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PdcCardRimBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource PdcRimThickness}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Text -->
    <Style x:Key="PdcTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource PdcDisplayFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="{ThemeResource PdcLabelSpacing}" />
        <Setter Property="Foreground" Value="{ThemeResource PdcTextPrimaryBrush}" />
    </Style>
    <Style x:Key="PdcCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource PdcFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource PdcTextMutedBrush}" />
    </Style>
    <Style x:Key="PdcBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource PdcFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource PdcFontBody}" />
        <Setter Property="Foreground" Value="{ThemeResource PdcTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="PdcMutedStyle" TargetType="TextBlock" BasedOn="{StaticResource PdcBodyStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource PdcTextMutedBrush}" />
    </Style>
    <Style x:Key="PdcValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource PdcNumberFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource PdcFontValue}" />
        <Setter Property="FontWeight" Value="SemiLight" />
        <Setter Property="Foreground" Value="{ThemeResource PdcTextPrimaryBrush}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="PdcInlineValueStyle" TargetType="TextBlock" BasedOn="{StaticResource PdcValueStyle}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- Buttons: hover lifts a wash, press shrinks fast, release springs back. -->
    <ControlTemplate x:Key="PdcSoftButtonTemplate" TargetType="Button">
        <Grid
            x:Name="Root"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PressScale" />
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition From="Pressed" GeneratedDuration="0:0:0.36">
                            <VisualTransition.GeneratedEasingFunction>
                                <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="0.07" Duration="{StaticResource PdcMotionHover}" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0" />
                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="{StaticResource PdcPressScale}" Duration="{StaticResource PdcMotionPress}" />
                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="{StaticResource PdcPressScale}" Duration="{StaticResource PdcMotionPress}" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Content" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" />
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Wash" Background="{ThemeResource PdcWashBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
            <ContentPresenter
                x:Name="Content"
                Padding="{TemplateBinding Padding}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                Foreground="{TemplateBinding Foreground}"
                FontFamily="{TemplateBinding FontFamily}"
                FontSize="{TemplateBinding FontSize}"
                FontWeight="{TemplateBinding FontWeight}" />
        </Grid>
    </ControlTemplate>
    <Style x:Key="PdcSoftButtonStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource PdcSoftButtonTemplate}" />
        <Setter Property="Background" Value="{ThemeResource PdcTransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{ThemeResource PdcFontFamily}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource PdcAccentBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource PdcShellBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource PdcFocusThickness}" />
        <Setter Property="FocusVisualMargin" Value="{StaticResource PdcFocusMargin}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="IsTabStop" Value="True" />
    </Style>
    <Style x:Key="PdcIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PdcSoftButtonStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{ThemeResource PdcRadiusRound}" />
        <Setter Property="Background" Value="{ThemeResource PdcChipBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PdcCardRimBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource PdcRimThickness}" />
        <Setter Property="Foreground" Value="{ThemeResource PdcTextPrimaryBrush}" />
    </Style>
    <Style x:Key="PdcTabButtonStyle" TargetType="Button" BasedOn="{StaticResource PdcSoftButtonStyle}">
        <Setter Property="CornerRadius" Value="{ThemeResource PdcRadiusInset}" />
        <Setter Property="Foreground" Value="{ThemeResource PdcTextMutedBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="4,9" />
    </Style>
    <Style x:Key="PdcSegmentButtonStyle" TargetType="Button" BasedOn="{StaticResource PdcSoftButtonStyle}">
        <Setter Property="CornerRadius" Value="{ThemeResource PdcRadiusChip}" />
        <Setter Property="Foreground" Value="{ThemeResource PdcTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{ThemeResource PdcFontBody}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="4,10" />
    </Style>
    <Style x:Key="PdcChipButtonStyle" TargetType="Button" BasedOn="{StaticResource PdcSoftButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource PdcChipBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PdcCardRimBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource PdcRimThickness}" />
        <Setter Property="CornerRadius" Value="{ThemeResource PdcRadiusChip}" />
        <Setter Property="Foreground" Value="{ThemeResource PdcTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{ThemeResource PdcFontBody}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="4,9" />
    </Style>
    <Style x:Key="PdcPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PdcChipButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource PdcAccentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PdcRimHiBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource PdcOnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <!-- Slider: track, fill (glow in skins that have one, LED gaps in skins that cut them) and a knob that grows while held. -->
    <Style x:Key="PdcSliderStyle" TargetType="Slider">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource PdcAccentBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource PdcShellBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource PdcFocusThickness}" />
        <Setter Property="FocusVisualMargin" Value="-6,-2" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="Root" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition From="Pressed" GeneratedDuration="0:0:0.36">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                    <VisualTransition GeneratedDuration="0:0:0.14" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="{StaticResource PdcThumbPressScale}" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="{StaticResource PdcThumbPressScale}" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HorizontalTemplate" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="HorizontalTemplate" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="HorizontalTrackRect" Grid.ColumnSpan="3" Height="{ThemeResource PdcTrackHeight}" Fill="{ThemeResource PdcTrackBrush}" />
                            <Rectangle x:Name="FillGlow" Height="18" RadiusX="9" RadiusY="9" Opacity="{ThemeResource PdcFillGlowOpacity}" Fill="{TemplateBinding Foreground}" IsHitTestVisible="False" />
                            <Rectangle x:Name="HorizontalDecreaseRect" Height="{ThemeResource PdcTrackHeight}" Fill="{TemplateBinding Foreground}" />
                            <Rectangle Grid.ColumnSpan="3" Height="{ThemeResource PdcTrackHeight}" Fill="{ThemeResource PdcSegmentMaskBrush}" IsHitTestVisible="False" />
                            <Thumb
                                x:Name="HorizontalThumb"
                                Grid.Column="1"
                                Width="{ThemeResource PdcThumbWidth}"
                                Height="{ThemeResource PdcThumbHeight}"
                                Background="{TemplateBinding Foreground}"
                                RenderTransformOrigin="0.5,0.5"
                                DataContext="{TemplateBinding Value}"
                                AutomationProperties.AccessibilityView="Raw">
                                <Thumb.RenderTransform>
                                    <ScaleTransform x:Name="ThumbScale" />
                                </Thumb.RenderTransform>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{ThemeResource PdcKnobBrush}" BorderBrush="{TemplateBinding Background}" BorderThickness="2" CornerRadius="{ThemeResource PdcRadiusThumb}" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <Grid x:Name="VerticalTemplate" Visibility="Collapsed">
                            <Rectangle x:Name="VerticalTrackRect" />
                            <Rectangle x:Name="VerticalDecreaseRect" />
                            <Thumb x:Name="VerticalThumb" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle: a track that fills with the accent and a knob that glides across with a soft overshoot. -->
    <Style x:Key="PdcToggleStyle" TargetType="ToggleSwitch">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource PdcAccentBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource PdcShellBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource PdcFocusThickness}" />
        <Setter Property="FocusVisualMargin" Value="{StaticResource PdcFocusMargin}" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Width" Value="50" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleSwitch">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.2" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Wash" Storyboard.TargetProperty="Opacity" To="0.08" Duration="{StaticResource PdcMotionHover}" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1.18" Duration="{StaticResource PdcMotionPress}" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SwitchRoot" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ToggleStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition From="Dragging" To="On" GeneratedDuration="0">
                                        <Storyboard>
                                            <RepositionThemeAnimation TargetName="SwitchKnob" FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobCurrentToOnOffset}" />
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition From="Dragging" To="Off" GeneratedDuration="0">
                                        <Storyboard>
                                            <RepositionThemeAnimation TargetName="SwitchKnob" FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobCurrentToOffOffset}" />
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition From="On" To="Off" GeneratedDuration="0:0:0.3">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                    <VisualTransition From="Off" To="On" GeneratedDuration="0:0:0.3">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Dragging" />
                                <VisualState x:Name="Off" />
                                <VisualState x:Name="On">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="20" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ContentStates">
                                <VisualState x:Name="OffContent" />
                                <VisualState x:Name="OnContent" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="HeaderContentPresenter" Visibility="Collapsed" />
                        <Grid x:Name="SwitchRoot" Width="50" Height="30" HorizontalAlignment="Right" Control.IsTemplateFocusTarget="True">
                            <Border x:Name="OuterBorder" CornerRadius="{ThemeResource PdcRadiusToggle}" Background="{ThemeResource PdcLayerStrongBrush}" BorderBrush="{ThemeResource PdcCardRimBrush}" BorderThickness="{ThemeResource PdcRimThickness}" />
                            <Border x:Name="SwitchKnobBounds" CornerRadius="{ThemeResource PdcRadiusToggle}" Background="{ThemeResource PdcAccentBrush}" BorderBrush="{ThemeResource PdcRimHiBrush}" BorderThickness="{ThemeResource PdcRimThickness}" Opacity="0" />
                            <Border x:Name="Wash" CornerRadius="{ThemeResource PdcRadiusToggle}" Background="{ThemeResource PdcWashBrush}" Opacity="0" />
                            <Grid x:Name="SwitchKnob" Width="22" Height="22" Margin="4,0,0,0" HorizontalAlignment="Left">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="KnobTranslateTransform" />
                                </Grid.RenderTransform>
                                <Border Background="{ThemeResource PdcKnobBrush}" CornerRadius="{ThemeResource PdcRadiusKnob}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="KnobScale" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <Thumb x:Name="SwitchThumb" AutomationProperties.AccessibilityView="Raw">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Rectangle Fill="Transparent" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

<Page
    x:Class="PanelDeControl.GameBar.ControlPanelWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource PdcShellBrush}"
    NavigationCacheMode="Disabled"
    KeyDown="Page_KeyDown"
    mc:Ignorable="d">

    <!-- Arrow keys move focus in 2-D like the D-pad: in compact Game Bar, Tab and Ctrl+Tab belong to Game Bar. -->
    <Grid XYFocusKeyboardNavigation="Enabled">
        <Grid x:Name="AuroraHost" IsHitTestVisible="False" />
        <Rectangle Fill="{StaticResource PdcBackdropRowsBrush}" IsHitTestVisible="False" />
        <Rectangle Fill="{StaticResource PdcBackdropColumnsBrush}" IsHitTestVisible="False" />
        <Rectangle Fill="{StaticResource PdcShellFadeBrush}" IsHitTestVisible="False" />

        <Grid x:Name="WidgetShell" Padding="16,16,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderBlock" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="10" Height="10" VerticalAlignment="Center">
                            <Ellipse x:Name="LiveHalo" Margin="-4" Fill="{StaticResource PdcOkBrush}" Opacity="0.3" />
                            <Ellipse x:Name="LiveDot" Fill="{StaticResource PdcOkBrush}" />
                        </Grid>
                        <TextBlock x:Name="DeviceName" x:Uid="DeviceName" Grid.Column="1" Style="{StaticResource PdcHeadlineStyle}" />
                        <Border x:Name="EarlyBadge" Grid.Column="2" Style="{StaticResource PdcBadgeStyle}">
                            <TextBlock x:Name="EarlyBadgeText" Style="{StaticResource PdcBadgeTextStyle}" />
                        </Border>
                    </Grid>
                    <StackPanel x:Name="HeaderDetail" Margin="0,8,0,0" Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource PdcPillStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE945;" Foreground="{StaticResource PdcBrightnessBrush}" Style="{StaticResource PdcIconSmallStyle}" />
                                <TextBlock x:Name="PowerSourceValue" Text="—" Style="{StaticResource PdcPillTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PdcPillStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEC4A;" Style="{StaticResource PdcIconSmallStyle}" />
                                <TextBlock x:Name="PowerModeValue" Text="—" Style="{StaticResource PdcPillTextStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="PowerModeDetail" Margin="0,6,0,0" Style="{StaticResource PdcMutedStyle}" />
                </StackPanel>
                <Button
                    x:Name="RefreshButton"
                    x:Uid="RefreshButton"
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    IsTabStop="True"
                    Click="RefreshButton_Click"
                    Style="{StaticResource PdcIconButtonStyle}">
                    <FontIcon x:Name="RefreshIcon" Glyph="&#xE72C;" Style="{StaticResource PdcIconNavStyle}" />
                </Button>
            </Grid>

            <StackPanel x:Name="StatusBlock" Grid.Row="1">
                <TextBlock x:Name="ConnectionStatus" x:Uid="ConnectionStatus" Margin="0,10,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" Style="{StaticResource PdcWarnTextStyle}" />
                <Button
                    x:Name="SteamHomeButton"
                    x:Uid="SteamHomeButton"
                    Margin="0,12,0,0"
                    Visibility="Collapsed"
                    Click="SteamHomeButton_Click"
                    Style="{StaticResource PdcPrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE80F;" Style="{StaticResource PdcIconNavStyle}" />
                        <TextBlock x:Uid="SteamHomeButtonText" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border x:Name="SectionTabsBar" Grid.Row="2" Margin="0,18,0,0" Style="{StaticResource PdcBarStyle}">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Margin="2,0,0,0" Style="{StaticResource PdcKeyHintStyle}">
                        <TextBlock Text="LB" Style="{StaticResource PdcMicroStyle}" />
                    </Border>
                    <ScrollViewer
                        x:Name="SectionTabsScroller"
                        Grid.Column="1"
                        HorizontalScrollMode="Enabled"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled"
                        SizeChanged="SectionTabsScroller_SizeChanged">
                        <Grid x:Name="SectionTabsLayer">
                            <Border x:Name="TabIndicator" Style="{StaticResource PdcTabIndicatorStyle}">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="TabIndicatorShift" />
                                </Border.RenderTransform>
                            </Border>
                            <Grid x:Name="SectionTabs" ColumnSpacing="4" TabFocusNavigation="Once" />
                        </Grid>
                    </ScrollViewer>
                    <Border Grid.Column="2" Margin="0,0,2,0" Style="{StaticResource PdcKeyHintStyle}">
                        <TextBlock Text="RB" Style="{StaticResource PdcMicroStyle}" />
                    </Border>
                </Grid>
            </Border>

            <StackPanel x:Name="SectionHeaderBlock" Grid.Row="3" Margin="2,18,2,12" Visibility="Collapsed">
                <TextBlock x:Name="SectionTitle" Style="{StaticResource PdcPageTitleStyle}" />
                <TextBlock x:Name="SectionDescription" Margin="0,2,0,0" Style="{StaticResource PdcMutedStyle}" />
            </StackPanel>

            <ScrollViewer x:Name="WidgetScroller" Grid.Row="4" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="SectionHost" />
            </ScrollViewer>
        </Grid>

        <Grid x:Name="DesktopShell" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Style="{StaticResource PdcSidebarStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="DesktopHeaderSlot" Margin="4,0,0,22" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DesktopNav" Spacing="2" />
                </ScrollViewer>
                <StackPanel x:Name="DesktopNavPinned" Grid.Row="2" Margin="0,12,0,0" Spacing="2" />
            </Grid>
            <ScrollViewer x:Name="DesktopScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DesktopContent" MaxWidth="1180" Padding="40,30,40,24" />
            </ScrollViewer>
        </Grid>

        <Grid x:Name="BlockLibrary" Visibility="Collapsed">
            <StackPanel x:Name="TdpBlock" Tag="power.tdp">
                <Grid Height="236">
                    <Grid
                        x:Name="HeroGlowHost"
                        Width="380"
                        Height="320"
                        Margin="0,-40,0,-24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False" />
                    <Viewbox x:Name="PowerArcView" Width="244" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="200" Height="184">
                            <Path
                                x:Name="PowerArcTicks"
                                Stroke="{StaticResource PdcTextMutedBrush}"
                                StrokeThickness="1.5"
                                Opacity="0.7"
                                Visibility="Collapsed" />
                            <Path
                                x:Name="PowerArcTrack"
                                Stroke="{StaticResource PdcTrackBrush}"
                                StrokeThickness="{StaticResource PdcArcThickness}"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                            <Path
                                x:Name="ChargerBand"
                                Stroke="{StaticResource PdcWarnBrush}"
                                Opacity="0.18"
                                StrokeThickness="{StaticResource PdcArcThickness}"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                            <Path
                                x:Name="PowerArcFill"
                                StrokeThickness="{StaticResource PdcArcThickness}"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                            <Path
                                x:Name="BoostArc"
                                Stroke="{StaticResource PdcBoostBrush}"
                                StrokeThickness="{StaticResource PdcArcThickness}"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round" />
                            <Path
                                x:Name="PowerArcShine"
                                Stroke="{StaticResource PdcKnobBrush}"
                                StrokeThickness="1.2"
                                Opacity="0.45"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                Visibility="Collapsed" />
                            <Canvas IsHitTestVisible="False">
                                <Ellipse
                                    x:Name="TdpMarker"
                                    Width="8"
                                    Height="8"
                                    Fill="{StaticResource PdcTextPrimaryBrush}"
                                    Visibility="Collapsed" />
                            </Canvas>
                        </Grid>
                    </Viewbox>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock
                                x:Name="PowerDrawValue"
                                Text="—"
                                Style="{StaticResource PdcHeroValueStyle}" />
                            <TextBlock
                                x:Name="HeroWattsUnit" Text="W" Style="{StaticResource PdcUnitStyle}" />
                            <TextBlock
                                x:Name="HeroPercentUnit" Text="%" Visibility="Collapsed"
                                Style="{StaticResource PdcUnitStyle}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="PowerZoneLabel" Style="{StaticResource PdcZoneStyle}" />
                    </StackPanel>
                    <Grid x:Name="LinearHero" Height="22" Margin="2,0,2,4" VerticalAlignment="Bottom" Visibility="Collapsed" SizeChanged="LinearHero_SizeChanged">
                        <Rectangle Height="2" Fill="{StaticResource PdcTrackBrush}" />
                        <Rectangle x:Name="LinearHeroFill" Width="0" Height="4" HorizontalAlignment="Left" Fill="{StaticResource PdcAccentBrush}" />
                    </Grid>
                </Grid>
                <TextBlock
                    x:Name="PowerDrawDetail"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Style="{StaticResource PdcMutedStyle}" />

                <Border x:Name="PowerCard" Style="{StaticResource PdcCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Uid="PowerLabel" Style="{StaticResource PdcTitleStyle}" />
                                <TextBlock x:Name="PowerLimits" x:Uid="PowerLimits" Margin="0,2,0,0" Style="{StaticResource PdcCaptionStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="PowerValue" Grid.Column="1" Text="—" VerticalAlignment="Center" Style="{StaticResource PdcValueMediumStyle}" />
                        </Grid>
                        <StackPanel x:Name="TdpControls">
                            <Slider
                                x:Name="TdpSlider"
                                x:Uid="TdpSlider"
                                Margin="0,8,0,0"
                                Minimum="0"
                                Maximum="1"
                                StepFrequency="1"
                                SmallChange="1"
                                IsEnabled="False"
                                IsTabStop="True"
                                Style="{StaticResource PdcSliderStyle}"
                                ValueChanged="TdpSlider_ValueChanged" />
                            <Grid x:Name="TdpPresetGrid" Margin="0,6,0,0" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="TdpPreset1" IsEnabled="False" IsTabStop="True" Style="{StaticResource PdcChipButtonStyle}" Click="TdpPresetButton_Click" />
                                <Button x:Name="TdpPreset2" Grid.Column="1" IsEnabled="False" IsTabStop="True" Style="{StaticResource PdcChipButtonStyle}" Click="TdpPresetButton_Click" />
                                <Button x:Name="TdpPreset3" Grid.Column="2" IsEnabled="False" IsTabStop="True" Style="{StaticResource PdcChipButtonStyle}" Click="TdpPresetButton_Click" />
                                <Button x:Name="TdpPreset4" Grid.Column="3" IsEnabled="False" IsTabStop="True" Style="{StaticResource PdcChipButtonStyle}" Click="TdpPresetButton_Click" />
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ExperimentalTdpLabel" VerticalAlignment="Center" Style="{StaticResource PdcBodyStyle}" />
                                <ToggleSwitch
                                    x:Name="ExperimentalTdpToggle"
                                    Style="{StaticResource PdcToggleStyle}"
                                    x:Uid="ExperimentalTdpToggle"
                                    Grid.Column="1"
                                    IsEnabled="False"
                                    IsTabStop="True"
                                    Toggled="ExperimentalTdpToggle_Toggled" />
                            </Grid>
                        </StackPanel>
                        <TextBlock
                            x:Name="PowerStatus"
                            x:Uid="PowerStatus"
                            Margin="0,6,0,0"
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource PdcMutedStyle}" />
                        <TextBlock
                            x:Name="ManufacturerRecoveryHint" x:Uid="ManufacturerRecoveryHint" Margin="0,6,0,0" Visibility="Collapsed" Style="{StaticResource PdcWarnTextStyle}" />
                        <TextBlock
                            x:Name="PowerReadbackHint"
                            x:Uid="PowerReadbackHint"
                            Margin="0,6,0,0"
                            Style="{StaticResource PdcFineStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border x:Name="PerformanceCard" Tag="power.steamPerformance" Style="{StaticResource PdcCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="PerformanceTitle" Style="{StaticResource PdcTitleStyle}" />
                    <TextBlock x:Name="RefreshRateLabel" Margin="0,14,0,0" Style="{StaticResource PdcBodyStyle}" />
                    <Border Margin="0,8,0,0" Style="{StaticResource PdcInsetStyle}">
                        <Grid x:Name="RefreshRateChips" ColumnSpacing="4" />
                    </Border>
                    <TextBlock
                        x:Name="RefreshRateStatus"
                        Margin="0,6,0,0"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource PdcCaptionStyle}" />
                </StackPanel>
            </Border>

            <Border x:Name="BatteryCard" Tag="power.energy" Style="{StaticResource PdcCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="EnergyTitle" Style="{StaticResource PdcTitleStyle}" />
                    <Grid Margin="0,14,0,0" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="132" Height="132">
                            <Ellipse x:Name="BatteryTrack" Style="{StaticResource PdcRingTrackStyle}" StrokeThickness="11" />
                            <Path x:Name="BatteryRing" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Ellipse Margin="15" Style="{StaticResource PdcRingTrackStyle}" StrokeThickness="11" />
                            <Path x:Name="CpuRing" Margin="15" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Ellipse Margin="30" Style="{StaticResource PdcRingTrackStyle}" StrokeThickness="11" />
                            <Path x:Name="GpuRing" Margin="30" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12">
                            <Grid x:Name="BatteryRow">
                                <TextBlock x:Name="BatteryCaption" x:Uid="BatteryLabel" VerticalAlignment="Center" Style="{StaticResource PdcLabelStyle}" />
                                <TextBlock x:Name="BatteryValue" Text="—" HorizontalAlignment="Right" Style="{StaticResource PdcValueMediumStyle}" />
                            </Grid>
                            <Grid>
                                <TextBlock x:Name="TileCpuCaption" Text="CPU" VerticalAlignment="Center" Style="{StaticResource PdcLabelStyle}" />
                                <TextBlock x:Name="TileCpuValue" Text="—" HorizontalAlignment="Right" Style="{StaticResource PdcValueMediumStyle}" />
                            </Grid>
                            <Grid>
                                <TextBlock x:Name="TileGpuCaption" Text="GPU" VerticalAlignment="Center" Style="{StaticResource PdcLabelStyle}" />
                                <TextBlock x:Name="TileGpuValue" Text="—" HorizontalAlignment="Right" Style="{StaticResource PdcValueMediumStyle}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="SystemBatteryCard" Tag="system.battery" Style="{StaticResource PdcCardStyle}">
                <StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PdcIconTileStyle}"><FontIcon Glyph="&#xEBA6;" Foreground="{StaticResource PdcOkBrush}" Style="{StaticResource PdcIconStyle}" /></Border>
                        <TextBlock x:Name="SystemBatteryTitle" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PdcTitleStyle}" />
                        <TextBlock x:Name="SystemBatteryValue" Grid.Column="2" Text="—" Style="{StaticResource PdcValueMediumStyle}" />
                    </Grid>
                    <TextBlock x:Name="SystemBatteryDetail" Margin="0,6,0,0" Style="{StaticResource PdcCaptionStyle}" />
                    <Grid Margin="0,14,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="BatteryHealthLabel" Style="{StaticResource PdcCaptionStyle}" />
                            <TextBlock x:Name="BatteryHealthValue" Margin="0,2,0,0" Text="—"  TextWrapping="Wrap" Style="{StaticResource PdcValueSmallStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="BatteryCapacityLabel" Style="{StaticResource PdcCaptionStyle}" />
                            <TextBlock x:Name="BatteryCapacityValue" Margin="0,2,0,0" Text="—"  TextWrapping="Wrap" Style="{StaticResource PdcValueSmallStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="BatteryCyclesLabel" Style="{StaticResource PdcCaptionStyle}" />
                            <TextBlock x:Name="BatteryCyclesValue" Margin="0,2,0,0" Text="—"  TextWrapping="Wrap" Style="{StaticResource PdcValueSmallStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="VolumeCard" Tag="system.volume" Style="{StaticResource PdcCardStyle}">
                <StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PdcIconTileStyle}"><FontIcon Glyph="&#xE767;" Style="{StaticResource PdcIconStyle}" /></Border>
                        <TextBlock x:Uid="VolumeLabel" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PdcTitleStyle}" />
                        <TextBlock x:Name="VolumeValue" Grid.Column="2" Text="—" Style="{StaticResource PdcValueMediumStyle}" />
                    </Grid>
                    <Slider
                        x:Name="VolumeSlider"
                        x:Uid="VolumeSlider"
                        Margin="0,6,0,0"
                        Minimum="0"
                        Maximum="100"
                        StepFrequency="5"
                        SmallChange="5"
                        IsEnabled="False"
                        IsTabStop="True"
                        Style="{StaticResource PdcSliderStyle}"
                        ValueChanged="VolumeSlider_ValueChanged" />
                    <TextBlock x:Name="VolumeStatus" x:Uid="VolumeStatus" Style="{StaticResource PdcCaptionStyle}" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Uid="MuteLabel" Style="{StaticResource PdcBodyStyle}" />
                            <TextBlock
                                x:Name="MuteStatus"
                                x:Uid="MuteStatus"
                                Margin="0,2,12,0"
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource PdcCaptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="MuteToggle"
                            Style="{StaticResource PdcToggleStyle}"
                            x:Uid="MuteToggle"
                            Grid.Column="1"
                            IsEnabled="False"
                            IsTabStop="True"
                            Toggled="MuteToggle_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="CpuControlCard" Tag="system.cpu" Style="{StaticResource PdcCardStyle}">
                <StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PdcIconTileStyle}"><FontIcon Glyph="&#xE950;" Style="{StaticResource PdcIconStyle}" /></Border>
                        <TextBlock x:Name="CpuControlTitle" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PdcTitleStyle}" />
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="CpuBoostLabel" VerticalAlignment="Center" Style="{StaticResource PdcBodyStyle}" />
                        <ToggleSwitch
                            x:Name="CpuBoostToggle"
                            Style="{StaticResource PdcToggleStyle}"
                            x:Uid="CpuBoostToggle"
                            Grid.Column="1"
                            IsEnabled="False"
                            IsTabStop="True"
                            Toggled="CpuBoostToggle_Toggled" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="CpuMaximumStateLabel" VerticalAlignment="Center" Style="{StaticResource PdcBodyStyle}" />
                        <TextBlock x:Name="CpuMaximumStateValue" Grid.Column="1" Text="—"  Style="{StaticResource PdcValueSmallStyle}" />
                    </Grid>
                    <Slider
                        x:Name="CpuMaximumStateSlider"
                        x:Uid="CpuMaximumStateSlider"
                        Margin="0,4,0,0"
                        Minimum="5"
                        Maximum="100"
                        StepFrequency="5"
                        SmallChange="5"
                        IsEnabled="False"
                        IsTabStop="True"
                        Style="{StaticResource PdcSliderStyle}"
                        ValueChanged="CpuMaximumStateSlider_ValueChanged" />
                    <TextBlock x:Name="CpuControlStatus" AutomationProperties.LiveSetting="Polite" Style="{StaticResource PdcCaptionStyle}" />
                    <TextBlock x:Name="CpuControlNote" Margin="0,10,0,0" Style="{StaticResource PdcFineStyle}" />
                </StackPanel>
            </Border>

            <Border x:Name="BrightnessCard" Tag="system.brightness" Style="{StaticResource PdcCardStyle}">
                <StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PdcIconTileStyle}"><FontIcon Glyph="&#xE706;" Foreground="{StaticResource PdcBrightnessBrush}" Style="{StaticResource PdcIconStyle}" /></Border>
                        <TextBlock x:Uid="BrightnessLabel" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PdcTitleStyle}" />
                        <TextBlock
                            x:Name="BrightnessValue"
                            Grid.Column="2"
                            Text="—"
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource PdcValueMediumStyle}" />
                    </Grid>
                    <Slider
                        x:Name="BrightnessSlider"
                        x:Uid="BrightnessSlider"
                        Margin="0,6,0,0"
                        Minimum="0"
                        Maximum="100"
                        StepFrequency="5"
                        SmallChange="5"
                        IsEnabled="False"
                        IsTabStop="True"
                        Style="{StaticResource PdcBrightnessSliderStyle}"
                        ValueChanged="BrightnessSlider_ValueChanged" />
                    <TextBlock x:Name="BrightnessStatus" x:Uid="BrightnessStatus" Style="{StaticResource PdcCaptionStyle}" />
                </StackPanel>
            </Border>

            <Border x:Name="FanCard" Tag="fans.fanRpm" Style="{StaticResource PdcCardStyle}">
                <StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PdcIconTileStyle}"><FontIcon Glyph="&#xE9CA;" Style="{StaticResource PdcIconStyle}" /></Border>
                        <TextBlock x:Name="FanTitle" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PdcTitleStyle}" />
                    </Grid>
                    <Grid Margin="0,14,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="FanOneLabel" Style="{StaticResource PdcLabelStyle}" />
                            <TextBlock x:Name="FanOneValue" Margin="0,4,0,0" Text="—"  TextWrapping="Wrap" Style="{StaticResource PdcValueLargeStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="FanTwoPanel" Grid.Column="1">
                            <TextBlock x:Name="FanTwoLabel" Style="{StaticResource PdcLabelStyle}" />
                            <TextBlock x:Name="FanTwoValue" Margin="0,4,0,0" Text="—"  TextWrapping="Wrap" Style="{StaticResource PdcValueLargeStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid x:Name="TempsBlock" Tag="fans.temps" Margin="0,0,0,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="CpuCard" Style="{StaticResource PdcTileStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="CPU" VerticalAlignment="Center" Style="{StaticResource PdcLabelStyle}" />
                            <Grid Width="30" Height="30" HorizontalAlignment="Right">
                                <Ellipse Style="{StaticResource PdcRingTrackStyle}" StrokeThickness="4" />
                                <Path x:Name="CpuLoadRing" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                        </Grid>
                        <TextBlock x:Name="CpuTemperatureValue" Margin="0,8,0,0" Text="—"  TextWrapping="Wrap" Style="{StaticResource PdcValueHugeStyle}" />
                        <TextBlock x:Name="CpuLoadValue" x:Uid="CpuLoadValue" Margin="0,6,0,0" Style="{StaticResource PdcCaptionStyle}" />
                    </StackPanel>
                </Border>
                <Border x:Name="GpuCard" Grid.Column="1" Style="{StaticResource PdcTileStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="GPU" VerticalAlignment="Center" Style="{StaticResource PdcLabelStyle}" />
                            <Grid Width="30" Height="30" HorizontalAlignment="Right">
                                <Ellipse Style="{StaticResource PdcRingTrackStyle}" StrokeThickness="4" />
                                <Path x:Name="GpuLoadRing" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                        </Grid>
                        <TextBlock x:Name="GpuTemperatureValue" Margin="0,8,0,0" Text="—"  TextWrapping="Wrap" Style="{StaticResource PdcValueHugeStyle}" />
                        <TextBlock x:Name="GpuLoadValue" x:Uid="GpuLoadValue" Margin="0,6,0,0" Style="{StaticResource PdcCaptionStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <ContentControl
                x:Name="ThemeLibraryHost"
                Tag="themes.library"
                HorizontalContentAlignment="Stretch"
                IsTabStop="False" />

            <Border x:Name="AccentCard" Tag="themes.accent" Style="{StaticResource PdcCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="SkinLabel" Style="{StaticResource PdcTitleStyle}" />
                    <Border Margin="0,10,0,0" Style="{StaticResource PdcInsetStyle}">
                        <Grid x:Name="SkinChoices" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="SkinAccentNote" Margin="0,10,0,0" Style="{StaticResource PdcMutedStyle}" Visibility="Collapsed" />
                    <TextBlock x:Name="AccentTitle" x:Uid="AccentLabel" Margin="0,18,0,0" Style="{StaticResource PdcTitleStyle}" />
                    <Grid x:Name="AccentSwatches" Margin="0,12,0,0" RowSpacing="4" />
                </StackPanel>
            </Border>

            <Border x:Name="ReportCard" Tag="settings.reports" Style="{StaticResource PdcCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="ReportTitle" Style="{StaticResource PdcTitleStyle}" />
                    <TextBlock x:Name="ReportIntro" Margin="0,4,0,0" TextWrapping="WrapWholeWords" Style="{StaticResource PdcMutedStyle}" />
                    <TextBlock x:Name="ReportKindLabel" Margin="0,16,0,8" Style="{StaticResource PdcBodyStyle}" />
                    <Border Style="{StaticResource PdcInsetStyle}">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ReportKindBug" Style="{StaticResource PdcSegmentButtonStyle}" Click="ReportKind_Click" />
                            <Button x:Name="ReportKindFeature" Grid.Column="1" Style="{StaticResource PdcSegmentButtonStyle}" Click="ReportKind_Click" />
                        </Grid>
                    </Border>
                    <Grid Margin="0,14,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ReportAreaLabel" VerticalAlignment="Center" Style="{StaticResource PdcBodyStyle}" />
                        <TextBlock x:Name="ReportAreaValue" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PdcBodyStrongStyle}" />
                    </Grid>
                    <TextBlock x:Name="ReportTextLabel" Margin="0,14,0,8" Style="{StaticResource PdcBodyStyle}" />
                    <TextBox
                        x:Name="ReportText"
                        MinHeight="104"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MaxLength="4000"
                        TextChanged="ReportText_TextChanged" />
                    <StackPanel Margin="0,12,0,0" Spacing="4">
                        <TextBlock x:Name="ReportPrivacyPublic" TextWrapping="WrapWholeWords" Style="{StaticResource PdcMutedStyle}" />
                        <TextBlock x:Name="ReportPrivacyPrivate" TextWrapping="WrapWholeWords" Style="{StaticResource PdcMutedStyle}" />
                    </StackPanel>
                    <Grid Margin="0,14,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ReportSendButton" IsEnabled="False" Style="{StaticResource PdcPrimaryButtonStyle}" Click="ReportSend_Click" />
                        <Button x:Name="ReportCopyButton" Grid.Column="1" Visibility="Collapsed" Style="{StaticResource PdcActionButtonStyle}" Click="ReportCopy_Click" />
                    </Grid>
                    <TextBlock
                        x:Name="ReportResultText"
                        Margin="0,10,0,0"
                        TextWrapping="WrapWholeWords"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource PdcCaptionStyle}" />
                </StackPanel>
            </Border>

            <Border x:Name="DiagnosticsCard" Tag="settings.diagnostics" Style="{StaticResource PdcFlushCardStyle}">
                <StackPanel>
                    <Button
                        x:Name="DiagnosticsToggle"
                        x:Uid="DiagnosticsToggle"
                        Style="{StaticResource PdcDisclosureButtonStyle}"
                        Click="DiagnosticsToggle_Click" />
                    <StackPanel
                        x:Name="DiagnosticsList"
                        Margin="12,4,12,10"
                        Visibility="Collapsed"
                        AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

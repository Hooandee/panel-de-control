<Page
    x:Class="PanelDeControl.GameBar.ControlPanelWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource PdcSurfaceBrush}"
    NavigationCacheMode="Disabled"
    KeyDown="Page_KeyDown"
    mc:Ignorable="d">

    <Grid>
        <Rectangle Height="460" VerticalAlignment="Top" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop x:Name="SectionGlowTop" Offset="0" Color="Transparent" />
                    <GradientStop Offset="1" Color="Transparent" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid MaxWidth="540" Padding="20,18,20,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        x:Name="DeviceName"
                        x:Uid="DeviceName"
                        FontFamily="{StaticResource PdcDisplayFontFamily}"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PdcTextPrimaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource PdcMutedStyle}" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                        <Run x:Name="PowerSourceValue" Text="—" />
                        <Run Text=" · " />
                        <Run x:Name="PowerModeValue" Text="—" />
                    </TextBlock>
                    <TextBlock x:Name="PowerModeDetail" Style="{StaticResource PdcMutedStyle}" />
                </StackPanel>
                <Button
                    x:Name="RefreshButton"
                    x:Uid="RefreshButton"
                    Grid.Column="1"
                    Width="38"
                    Height="38"
                    Padding="0"
                    VerticalAlignment="Top"
                    IsTabStop="True"
                    Click="RefreshButton_Click"
                    CornerRadius="19"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{StaticResource PdcTextMutedBrush}">
                    <FontIcon FontFamily="{StaticResource PdcIconFontFamily}" FontSize="15" Glyph="&#xE72C;" />
                </Button>
            </Grid>

            <TextBlock
                x:Name="ConnectionStatus"
                x:Uid="ConnectionStatus"
                Grid.Row="1"
                Margin="0,10,0,0"
                Foreground="{StaticResource PdcWarnBrush}"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource PdcMutedStyle}" />

            <Border Grid.Row="2" Margin="0,16,0,6" Padding="4" CornerRadius="18" Background="{StaticResource PdcLayerBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="TabThumb" CornerRadius="{StaticResource PdcRadiusInset}" Background="{StaticResource PdcLayerStrongBrush}">
                        <Border.Transitions>
                            <TransitionCollection>
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </Border.Transitions>
                    </Border>
                    <Button x:Name="TabPower" x:Uid="TabPower" Grid.Column="0" Tag="0" Style="{StaticResource PdcTabButtonStyle}" Click="TabButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{StaticResource PdcIconFontFamily}" FontSize="14" Glyph="&#xE945;" />
                            <TextBlock x:Uid="TabPowerLabel" FontSize="{StaticResource PdcFontBody}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabSystem" x:Uid="TabSystem" Grid.Column="1" Tag="1" Style="{StaticResource PdcTabButtonStyle}" Click="TabButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{StaticResource PdcIconFontFamily}" FontSize="14" Glyph="&#xE767;" />
                            <TextBlock x:Uid="TabSystemLabel" FontSize="{StaticResource PdcFontBody}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabSensors" x:Uid="TabSensors" Grid.Column="2" Tag="2" Style="{StaticResource PdcTabButtonStyle}" Click="TabButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{StaticResource PdcIconFontFamily}" FontSize="14" Glyph="&#xE9D9;" />
                            <TextBlock x:Uid="TabSensorsLabel" FontSize="{StaticResource PdcFontBody}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabSettings" x:Uid="TabSettings" Grid.Column="3" Tag="3" Style="{StaticResource PdcTabButtonStyle}" Click="TabButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{StaticResource PdcIconFontFamily}" FontSize="14" Glyph="&#xE713;" />
                            <TextBlock x:Uid="TabSettingsLabel" FontSize="{StaticResource PdcFontBody}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,6,0,0">
                <Grid>
                    <StackPanel x:Name="PowerPanel">
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="12" />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>
                        <Grid Height="256" Margin="0,0,0,4">
                            <Grid
                                x:Name="HeroGlowHost"
                                Width="380"
                                Height="320"
                                Margin="0,-40,0,-24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False" />
                            <Viewbox Width="244" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="200" Height="184">
                                    <Path
                                        x:Name="PowerArcTrack"
                                        Stroke="{StaticResource PdcTrackBrush}"
                                        StrokeThickness="10"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round" />
                                    <Path
                                        x:Name="PowerArcFill"
                                        StrokeThickness="10"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round" />
                                    <Canvas IsHitTestVisible="False">
                                        <Ellipse
                                            x:Name="TdpMarker"
                                            Width="8"
                                            Height="8"
                                            Fill="{StaticResource PdcTextPrimaryBrush}"
                                            Visibility="Collapsed" />
                                    </Canvas>
                                </Grid>
                            </Viewbox>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock
                                        x:Name="PowerDrawValue"
                                        Text="—"
                                        FontSize="60"
                                        FontWeight="Light"
                                        Style="{StaticResource PdcValueStyle}" />
                                    <TextBlock
                                        x:Name="HeroWattsUnit"
                                        Margin="4,0,0,12"
                                        VerticalAlignment="Bottom"
                                        Text="W"
                                        FontFamily="{StaticResource PdcDisplayFontFamily}"
                                        FontSize="18"
                                        Foreground="{StaticResource PdcTextMutedBrush}" />
                                    <TextBlock
                                        x:Name="HeroPercentUnit"
                                        Margin="4,0,0,12"
                                        VerticalAlignment="Bottom"
                                        Text="%"
                                        Visibility="Collapsed"
                                        FontFamily="{StaticResource PdcDisplayFontFamily}"
                                        FontSize="18"
                                        Foreground="{StaticResource PdcTextMutedBrush}" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="PowerZoneLabel"
                                    HorizontalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource PdcCaptionStyle}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            x:Name="PowerDrawDetail"
                            Margin="0,0,0,18"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            Style="{StaticResource PdcMutedStyle}" />

                        <Border x:Name="BatteryCard" Style="{StaticResource PdcCardStyle}" Padding="20,18">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="132" Height="132">
                                    <Ellipse Stroke="{StaticResource PdcTrackBrush}" StrokeThickness="11" />
                                    <Path x:Name="BatteryRing" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Ellipse Margin="15" Stroke="{StaticResource PdcTrackBrush}" StrokeThickness="11" />
                                    <Path x:Name="CpuRing" Margin="15" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Ellipse Margin="30" Stroke="{StaticResource PdcTrackBrush}" StrokeThickness="11" />
                                    <Path x:Name="GpuRing" Margin="30" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12">
                                    <Grid>
                                        <TextBlock x:Name="BatteryCaption" x:Uid="BatteryLabel" VerticalAlignment="Center" Style="{StaticResource PdcCaptionStyle}" FontSize="13" />
                                        <TextBlock x:Name="BatteryValue" Text="—" HorizontalAlignment="Right" FontSize="22" Style="{StaticResource PdcValueStyle}" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock x:Name="TileCpuCaption" Text="CPU" VerticalAlignment="Center" Style="{StaticResource PdcCaptionStyle}" FontSize="13" />
                                        <TextBlock x:Name="TileCpuValue" Text="—" HorizontalAlignment="Right" FontSize="22" Style="{StaticResource PdcValueStyle}" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock x:Name="TileGpuCaption" Text="GPU" VerticalAlignment="Center" Style="{StaticResource PdcCaptionStyle}" FontSize="13" />
                                        <TextBlock x:Name="TileGpuValue" Text="—" HorizontalAlignment="Right" FontSize="22" Style="{StaticResource PdcValueStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="PowerCard" Style="{StaticResource PdcCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="PowerLabel" VerticalAlignment="Center" Style="{StaticResource PdcTitleStyle}" />
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock x:Name="PowerValue" Text="—" HorizontalAlignment="Right" FontSize="22" Style="{StaticResource PdcValueStyle}" />
                                        <TextBlock x:Name="PowerLimits" x:Uid="PowerLimits" HorizontalAlignment="Right" Style="{StaticResource PdcCaptionStyle}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="TdpControls">
                                    <Grid Margin="0,14,0,0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="TdpDecreaseButton"
                                            x:Uid="TdpDecreaseButton"
                                            IsEnabled="False"
                                            IsTabStop="True"
                                            Style="{StaticResource PdcRoundButtonStyle}"
                                            Click="TdpDecreaseButton_Click" />
                                        <Grid Grid.Column="1" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="TdpPreset1" IsEnabled="False" IsTabStop="True" Style="{StaticResource PdcChipButtonStyle}" Click="TdpPresetButton_Click" />
                                            <Button x:Name="TdpPreset2" Grid.Column="1" IsEnabled="False" IsTabStop="True" Style="{StaticResource PdcChipButtonStyle}" Click="TdpPresetButton_Click" />
                                            <Button x:Name="TdpPreset3" Grid.Column="2" IsEnabled="False" IsTabStop="True" Style="{StaticResource PdcChipButtonStyle}" Click="TdpPresetButton_Click" />
                                            <Button x:Name="TdpPreset4" Grid.Column="3" IsEnabled="False" IsTabStop="True" Style="{StaticResource PdcChipButtonStyle}" Click="TdpPresetButton_Click" />
                                        </Grid>
                                        <Button
                                            x:Name="TdpIncreaseButton"
                                            x:Uid="TdpIncreaseButton"
                                            Grid.Column="2"
                                            IsEnabled="False"
                                            IsTabStop="True"
                                            Style="{StaticResource PdcRoundButtonStyle}"
                                            Click="TdpIncreaseButton_Click" />
                                    </Grid>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="ExperimentalTdpLabel" VerticalAlignment="Center" Style="{StaticResource PdcBodyStyle}" />
                                        <ToggleSwitch
                                            x:Name="ExperimentalTdpToggle"
                                            x:Uid="ExperimentalTdpToggle"
                                            Grid.Column="1"
                                            MinWidth="0"
                                            IsEnabled="False"
                                            IsTabStop="True"
                                            Toggled="ExperimentalTdpToggle_Toggled" />
                                    </Grid>
                                </StackPanel>
                                <TextBlock
                                    x:Name="PowerStatus"
                                    x:Uid="PowerStatus"
                                    Margin="0,6,0,0"
                                    AutomationProperties.LiveSetting="Polite"
                                    Style="{StaticResource PdcMutedStyle}" />
                                <TextBlock
                                    x:Name="ManufacturerRecoveryHint"
                                    x:Uid="ManufacturerRecoveryHint"
                                    Margin="0,6,0,0"
                                    Foreground="{StaticResource PdcWarnBrush}"
                                    Visibility="Collapsed"
                                    Style="{StaticResource PdcMutedStyle}" />
                                <TextBlock
                                    x:Uid="PowerReadbackHint"
                                    Margin="0,6,0,0"
                                    FontSize="11"
                                    Style="{StaticResource PdcMutedStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SystemPanel" Visibility="Collapsed">
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="12" />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>
                        <Border x:Name="VolumeCard" Style="{StaticResource PdcCardStyle}">
                            <StackPanel>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontFamily="{StaticResource PdcIconFontFamily}" FontSize="16" Glyph="&#xE767;" Foreground="{StaticResource PdcAccentBrush}" />
                                    <TextBlock x:Uid="VolumeLabel" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PdcTitleStyle}" />
                                    <TextBlock x:Name="VolumeValue" Grid.Column="2" Text="—" FontSize="22" Style="{StaticResource PdcValueStyle}" />
                                </Grid>
                                <Slider
                                    x:Name="VolumeSlider"
                                    x:Uid="VolumeSlider"
                                    Margin="0,6,0,0"
                                    Minimum="0"
                                    Maximum="100"
                                    StepFrequency="5"
                                    SmallChange="5"
                                    IsEnabled="False"
                                    IsTabStop="True"
                                    Foreground="{StaticResource PdcAccentBrush}"
                                    ValueChanged="VolumeSlider_ValueChanged" />
                                <TextBlock x:Name="VolumeStatus" x:Uid="VolumeStatus" Style="{StaticResource PdcCaptionStyle}" />
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Uid="MuteLabel" Style="{StaticResource PdcBodyStyle}" />
                                        <TextBlock
                                            x:Name="MuteStatus"
                                            x:Uid="MuteStatus"
                                            Margin="0,2,12,0"
                                            AutomationProperties.LiveSetting="Polite"
                                            Style="{StaticResource PdcCaptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="MuteToggle"
                                        x:Uid="MuteToggle"
                                        Grid.Column="1"
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        IsEnabled="False"
                                        IsTabStop="True"
                                        Toggled="MuteToggle_Toggled" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="BrightnessCard" Style="{StaticResource PdcCardStyle}">
                            <StackPanel>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontFamily="{StaticResource PdcIconFontFamily}" FontSize="16" Glyph="&#xE706;" Foreground="{StaticResource PdcBrightnessBrush}" />
                                    <TextBlock x:Uid="BrightnessLabel" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PdcTitleStyle}" />
                                    <TextBlock
                                        x:Name="BrightnessValue"
                                        Grid.Column="2"
                                        Text="—"
                                        FontSize="22"
                                        AutomationProperties.LiveSetting="Polite"
                                        Style="{StaticResource PdcValueStyle}" />
                                </Grid>
                                <Slider
                                    x:Name="BrightnessSlider"
                                    x:Uid="BrightnessSlider"
                                    Margin="0,6,0,0"
                                    Minimum="0"
                                    Maximum="100"
                                    StepFrequency="5"
                                    SmallChange="5"
                                    IsEnabled="False"
                                    IsTabStop="True"
                                    Foreground="{StaticResource PdcBrightnessBrush}"
                                    ValueChanged="BrightnessSlider_ValueChanged" />
                                <TextBlock x:Name="BrightnessStatus" x:Uid="BrightnessStatus" Style="{StaticResource PdcCaptionStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SensorsPanel" Visibility="Collapsed">
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="12" />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CpuCard" Style="{StaticResource PdcTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="CPU" Style="{StaticResource PdcCaptionStyle}" FontSize="13" />
                                    <TextBlock x:Name="CpuTemperatureValue" Margin="0,10,0,0" Text="—" FontSize="40" FontWeight="Light" Style="{StaticResource PdcValueStyle}" />
                                    <TextBlock x:Name="CpuLoadValue" x:Uid="CpuLoadValue" Margin="0,6,0,0" Style="{StaticResource PdcCaptionStyle}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="GpuCard" Grid.Column="1" Style="{StaticResource PdcTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="GPU" Style="{StaticResource PdcCaptionStyle}" FontSize="13" />
                                    <TextBlock x:Name="GpuTemperatureValue" Margin="0,10,0,0" Text="—" FontSize="40" FontWeight="Light" Style="{StaticResource PdcValueStyle}" />
                                    <TextBlock x:Name="GpuLoadValue" x:Uid="GpuLoadValue" Margin="0,6,0,0" Style="{StaticResource PdcCaptionStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="12" />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>
                        <Border x:Name="AccentCard" Style="{StaticResource PdcCardStyle}">
                            <StackPanel>
                                <TextBlock x:Uid="AccentLabel" Style="{StaticResource PdcTitleStyle}" />
                                <VariableSizedWrapGrid
                                    x:Name="AccentSwatches"
                                    Margin="-4,12,0,0"
                                    Orientation="Horizontal"
                                    ItemWidth="42"
                                    ItemHeight="42" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="DiagnosticsCard" Style="{StaticResource PdcCardStyle}" Padding="6">
                            <StackPanel>
                                <Button
                                    x:Name="DiagnosticsToggle"
                                    x:Uid="DiagnosticsToggle"
                                    Padding="12,10"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    IsTabStop="True"
                                    CornerRadius="{StaticResource PdcRadiusInset}"
                                    Background="Transparent"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PdcTextPrimaryBrush}"
                                    Click="DiagnosticsToggle_Click" />
                                <StackPanel
                                    x:Name="DiagnosticsList"
                                    Margin="12,4,12,10"
                                    Visibility="Collapsed"
                                    AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

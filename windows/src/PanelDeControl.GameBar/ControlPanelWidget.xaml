<Page
    x:Class="PanelDeControl.GameBar.ControlPanelWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource PdcSurfaceBrush}"
    NavigationCacheMode="Disabled"
    KeyDown="Page_KeyDown"
    mc:Ignorable="d">

    <Grid>
        <Rectangle Height="340" VerticalAlignment="Top" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop x:Name="SectionGlowTop" Offset="0" Color="Transparent" />
                    <GradientStop Offset="1" Color="Transparent" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Padding="16,14,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        x:Name="DeviceName"
                        x:Uid="DeviceName"
                        FontFamily="{StaticResource PdcFontFamily}"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PdcTextPrimaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Uid="HeaderSubtitle" Margin="0,2,0,0" Style="{StaticResource PdcMutedStyle}" />
                </StackPanel>
                <StackPanel x:Name="ExperimentalPill" Grid.Column="1" Margin="8,0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse x:Name="ExperimentalDot" Width="6" Height="6" VerticalAlignment="Center" />
                    <TextBlock x:Name="ExperimentalBadge" x:Uid="ExperimentalBadge" Style="{StaticResource PdcCaptionStyle}" />
                </StackPanel>
                <Button
                    x:Name="RefreshButton"
                    x:Uid="RefreshButton"
                    Grid.Column="2"
                    Width="36"
                    Height="36"
                    Padding="0"
                    IsTabStop="True"
                    Click="RefreshButton_Click"
                    CornerRadius="{StaticResource PdcRadiusControl}"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{StaticResource PdcTextMutedBrush}">
                    <FontIcon FontFamily="{StaticResource PdcIconFontFamily}" FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,14,0,0" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="TabPower" x:Uid="TabPower" Grid.Column="0" Tag="0" Style="{StaticResource PdcTabButtonStyle}" Click="TabButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{StaticResource PdcIconFontFamily}" FontSize="14" Glyph="&#xE945;" />
                        <TextBlock x:Uid="TabPowerLabel" FontSize="{StaticResource PdcFontBody}" />
                    </StackPanel>
                </Button>
                <Button x:Name="TabSystem" x:Uid="TabSystem" Grid.Column="1" Tag="1" Style="{StaticResource PdcTabButtonStyle}" Click="TabButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{StaticResource PdcIconFontFamily}" FontSize="14" Glyph="&#xE767;" />
                        <TextBlock x:Uid="TabSystemLabel" FontSize="{StaticResource PdcFontBody}" />
                    </StackPanel>
                </Button>
                <Button x:Name="TabSensors" x:Uid="TabSensors" Grid.Column="2" Tag="2" Style="{StaticResource PdcTabButtonStyle}" Click="TabButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{StaticResource PdcIconFontFamily}" FontSize="14" Glyph="&#xE9D9;" />
                        <TextBlock x:Uid="TabSensorsLabel" FontSize="{StaticResource PdcFontBody}" />
                    </StackPanel>
                </Button>
                <Button x:Name="TabSettings" x:Uid="TabSettings" Grid.Column="3" Tag="3" Style="{StaticResource PdcTabButtonStyle}" Click="TabButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{StaticResource PdcIconFontFamily}" FontSize="14" Glyph="&#xE713;" />
                        <TextBlock x:Uid="TabSettingsLabel" FontSize="{StaticResource PdcFontBody}" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="2" Margin="2,10,2,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse
                    x:Name="ConnectionDot"
                    Width="6"
                    Height="6"
                    Margin="0,0,8,0"
                    Fill="{StaticResource PdcTextMutedBrush}" />
                <TextBlock
                    x:Name="ConnectionStatus"
                    x:Uid="ConnectionStatus"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource PdcMutedStyle}" />
                <TextBlock
                    x:Name="LastUpdated"
                    Grid.Column="2"
                    Text="—"
                    VerticalAlignment="Center"
                    Style="{StaticResource PdcMutedStyle}"
                    Typography.NumeralAlignment="Tabular" />
            </Grid>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel x:Name="PowerPanel">
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="16" />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>
                        <Border x:Name="EnergyCard" Style="{StaticResource PdcCardStyle}">
                            <StackPanel>
                                <TextBlock x:Uid="EnergyLabel" Style="{StaticResource PdcCaptionStyle}" />
                                <Grid Width="220" Height="196" Margin="0,4,0,0" HorizontalAlignment="Center">
                                    <Grid x:Name="HeroGlowHost" Width="220" Height="196" IsHitTestVisible="False" />
                                    <Path
                                        x:Name="PowerArcTrack"
                                        Width="200"
                                        Height="184"
                                        Stroke="{StaticResource PdcTrackBrush}"
                                        StrokeThickness="12"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round" />
                                    <Path
                                        x:Name="PowerArcFill"
                                        Width="200"
                                        Height="184"
                                        StrokeThickness="12"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round" />
                                    <Canvas Width="200" Height="184" IsHitTestVisible="False">
                                        <Ellipse
                                            x:Name="TdpMarker"
                                            Width="10"
                                            Height="10"
                                            Fill="{StaticResource PdcTextPrimaryBrush}"
                                            Visibility="Collapsed" />
                                    </Canvas>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock
                                                x:Name="PowerDrawValue"
                                                Text="—"
                                                FontSize="40"
                                                Style="{StaticResource PdcValueStyle}" />
                                            <TextBlock
                                                Margin="4,0,0,6"
                                                VerticalAlignment="Bottom"
                                                Text="W"
                                                FontSize="16"
                                                Foreground="{StaticResource PdcTextMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="PowerZoneLabel"
                                            Margin="0,2,0,0"
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource PdcCaptionStyle}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    x:Name="PowerDrawDetail"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    TextAlignment="Center"
                                    Style="{StaticResource PdcMutedStyle}" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="BatteryCard" Style="{StaticResource PdcCardStyle}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <Grid Width="84" Height="84">
                                        <Ellipse Stroke="{StaticResource PdcTrackBrush}" StrokeThickness="7" />
                                        <Path x:Name="BatteryRing" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <TextBlock
                                            x:Name="BatteryValue"
                                            Text="—"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            Style="{StaticResource PdcValueStyle}" />
                                    </Grid>
                                    <TextBlock x:Name="BatteryCaption" x:Uid="BatteryLabel" Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource PdcCaptionStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <Grid Width="84" Height="84">
                                        <Ellipse Stroke="{StaticResource PdcTrackBrush}" StrokeThickness="7" />
                                        <Path x:Name="CpuRing" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <TextBlock
                                            x:Name="TileCpuValue"
                                            Text="—"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            Style="{StaticResource PdcValueStyle}" />
                                    </Grid>
                                    <TextBlock x:Name="TileCpuCaption" Text="CPU" Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource PdcCaptionStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <Grid Width="84" Height="84">
                                        <Ellipse Stroke="{StaticResource PdcTrackBrush}" StrokeThickness="7" />
                                        <Path x:Name="GpuRing" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <TextBlock
                                            x:Name="TileGpuValue"
                                            Text="—"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            Style="{StaticResource PdcValueStyle}" />
                                    </Grid>
                                    <TextBlock x:Name="TileGpuCaption" Text="GPU" Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource PdcCaptionStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="ModeCard" Style="{StaticResource PdcCardStyle}" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="PowerModeValue" Text="—" Style="{StaticResource PdcBodyStyle}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="PowerModeDetail" Margin="0,2,0,0" Style="{StaticResource PdcMutedStyle}" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="PowerSourceValue"
                                    Grid.Column="1"
                                    Text="—"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource PdcMutedStyle}" />
                            </Grid>
                        </Border>

                        <Border x:Name="PowerCard" Style="{StaticResource PdcCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="PowerLabel" VerticalAlignment="Center" Style="{StaticResource PdcCaptionStyle}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="PowerValue" Text="—" VerticalAlignment="Center" Style="{StaticResource PdcInlineValueStyle}" />
                                        <TextBlock x:Name="PowerLimits" x:Uid="PowerLimits" VerticalAlignment="Center" Style="{StaticResource PdcMutedStyle}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="TdpControls">
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="TdpPreset1" Margin="0,0,3,0" IsEnabled="False" IsTabStop="True" Style="{StaticResource PdcChipButtonStyle}" Click="TdpPresetButton_Click" />
                                    <Button x:Name="TdpPreset2" Grid.Column="1" Margin="3,0" IsEnabled="False" IsTabStop="True" Style="{StaticResource PdcChipButtonStyle}" Click="TdpPresetButton_Click" />
                                    <Button x:Name="TdpPreset3" Grid.Column="2" Margin="3,0" IsEnabled="False" IsTabStop="True" Style="{StaticResource PdcChipButtonStyle}" Click="TdpPresetButton_Click" />
                                    <Button x:Name="TdpPreset4" Grid.Column="3" Margin="3,0,0,0" IsEnabled="False" IsTabStop="True" Style="{StaticResource PdcChipButtonStyle}" Click="TdpPresetButton_Click" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="TdpDecreaseButton"
                                        x:Uid="TdpDecreaseButton"
                                        Width="40"
                                        Height="32"
                                        IsEnabled="False"
                                        IsTabStop="True"
                                        Style="{StaticResource PdcChipButtonStyle}"
                                        Click="TdpDecreaseButton_Click" />
                                    <TextBlock
                                        x:Uid="PowerStepHint"
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PdcMutedStyle}" />
                                    <Button
                                        x:Name="TdpIncreaseButton"
                                        x:Uid="TdpIncreaseButton"
                                        Grid.Column="2"
                                        Width="40"
                                        Height="32"
                                        IsEnabled="False"
                                        IsTabStop="True"
                                        Style="{StaticResource PdcChipButtonStyle}"
                                        Click="TdpIncreaseButton_Click" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Uid="ExperimentalTdpLabel"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PdcBodyStyle}" />
                                    <ToggleSwitch
                                        x:Name="ExperimentalTdpToggle"
                                        x:Uid="ExperimentalTdpToggle"
                                        Grid.Column="1"
                                        MinWidth="0"
                                        IsEnabled="False"
                                        IsTabStop="True"
                                        Toggled="ExperimentalTdpToggle_Toggled" />
                                </Grid>
                                </StackPanel>
                                <TextBlock
                                    x:Name="PowerStatus"
                                    x:Uid="PowerStatus"
                                    Margin="0,8,0,0"
                                    AutomationProperties.LiveSetting="Polite"
                                    Style="{StaticResource PdcMutedStyle}" />
                                <TextBlock
                                    x:Name="ManufacturerRecoveryHint"
                                    x:Uid="ManufacturerRecoveryHint"
                                    Margin="0,6,0,0"
                                    Foreground="{StaticResource PdcWarnBrush}"
                                    Visibility="Collapsed"
                                    Style="{StaticResource PdcMutedStyle}" />
                                <TextBlock
                                    x:Uid="PowerReadbackHint"
                                    Margin="0,6,0,0"
                                    Style="{StaticResource PdcMutedStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SystemPanel" Visibility="Collapsed">
                        <Border x:Name="VolumeCard" Style="{StaticResource PdcCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="VolumeLabel" Style="{StaticResource PdcCaptionStyle}" />
                                    <TextBlock x:Name="VolumeValue" Grid.Column="1" Text="—" Style="{StaticResource PdcInlineValueStyle}" />
                                </Grid>
                                <Slider
                                    x:Name="VolumeSlider"
                                    x:Uid="VolumeSlider"
                                    Margin="0,8,0,0"
                                    Minimum="0"
                                    Maximum="100"
                                    StepFrequency="5"
                                    SmallChange="5"
                                    IsEnabled="False"
                                    IsTabStop="True"
                                    Foreground="{StaticResource PdcAccentBrush}"
                                    ValueChanged="VolumeSlider_ValueChanged" />
                                <TextBlock x:Name="VolumeStatus" x:Uid="VolumeStatus" Style="{StaticResource PdcMutedStyle}" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Uid="MuteLabel" Style="{StaticResource PdcCaptionStyle}" />
                                        <TextBlock
                                            x:Name="MuteStatus"
                                            x:Uid="MuteStatus"
                                            Margin="0,4,12,0"
                                            AutomationProperties.LiveSetting="Polite"
                                            Style="{StaticResource PdcMutedStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="MuteToggle"
                                        x:Uid="MuteToggle"
                                        Grid.Column="1"
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        IsEnabled="False"
                                        IsTabStop="True"
                                        Toggled="MuteToggle_Toggled" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="BrightnessCard" Style="{StaticResource PdcCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="BrightnessLabel" Style="{StaticResource PdcCaptionStyle}" />
                                    <TextBlock
                                        x:Name="BrightnessValue"
                                        Grid.Column="1"
                                        Text="—"
                                        AutomationProperties.LiveSetting="Polite"
                                        Style="{StaticResource PdcInlineValueStyle}" />
                                </Grid>
                                <Slider
                                    x:Name="BrightnessSlider"
                                    x:Uid="BrightnessSlider"
                                    Margin="0,8,0,0"
                                    Minimum="0"
                                    Maximum="100"
                                    StepFrequency="5"
                                    SmallChange="5"
                                    IsEnabled="False"
                                    IsTabStop="True"
                                    Foreground="{StaticResource PdcBrightnessBrush}"
                                    ValueChanged="BrightnessSlider_ValueChanged" />
                                <TextBlock x:Name="BrightnessStatus" x:Uid="BrightnessStatus" Style="{StaticResource PdcMutedStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SensorsPanel" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CpuCard" Margin="0,0,6,12" Style="{StaticResource PdcTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="CPU" Style="{StaticResource PdcCaptionStyle}" />
                                    <TextBlock x:Name="CpuTemperatureValue" Margin="0,4,0,0" Text="—" Style="{StaticResource PdcValueStyle}" />
                                    <TextBlock x:Name="CpuLoadValue" x:Uid="CpuLoadValue" Margin="0,6,0,0" Style="{StaticResource PdcMutedStyle}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="GpuCard" Grid.Column="1" Margin="6,0,0,12" Style="{StaticResource PdcTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="GPU" Style="{StaticResource PdcCaptionStyle}" />
                                    <TextBlock x:Name="GpuTemperatureValue" Margin="0,4,0,0" Text="—" Style="{StaticResource PdcValueStyle}" />
                                    <TextBlock x:Name="GpuLoadValue" x:Uid="GpuLoadValue" Margin="0,6,0,0" Style="{StaticResource PdcMutedStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                        <Border x:Name="AccentCard" Style="{StaticResource PdcCardStyle}">
                            <StackPanel>
                                <TextBlock x:Uid="AccentLabel" Style="{StaticResource PdcCaptionStyle}" />
                                <VariableSizedWrapGrid
                                    x:Name="AccentSwatches"
                                    Margin="0,10,0,0"
                                    Orientation="Horizontal"
                                    ItemWidth="36"
                                    ItemHeight="36" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="DiagnosticsCard" Style="{StaticResource PdcCardStyle}">
                            <StackPanel>
                                <Button
                                    x:Name="DiagnosticsToggle"
                                    x:Uid="DiagnosticsToggle"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    IsTabStop="True"
                                    Background="Transparent"
                                    Foreground="{StaticResource PdcTextPrimaryBrush}"
                                    Click="DiagnosticsToggle_Click" />
                                <StackPanel
                                    x:Name="DiagnosticsList"
                                    Margin="0,10,0,0"
                                    Visibility="Collapsed"
                                    AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

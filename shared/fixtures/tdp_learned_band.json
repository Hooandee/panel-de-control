      "id": "gpu_headroom_defines_floor",
      "input": {
        "by_pl1": {
          "12": {"seconds": 700.0, "gpu_avg": 99.0, "watts_avg": 11.8},
          "18": {"seconds": 800.0, "gpu_avg": 88.0, "watts_avg": 15.0},
          "24": {"seconds": 700.0, "gpu_avg": 70.0, "watts_avg": 17.0}
        }
      },
      "expected": {
        "floor": 18,
        "ceil": 24,
        "seed": 18,
        "observed_lo": 12,
        "observed_hi": 24,
        "enough": true,
        "reason": "ok"
      }
    },
    {
      "id": "watts_are_used_when_gpu_is_missing",
